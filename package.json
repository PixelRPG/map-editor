{
  "name": "pixelrpg",
  "version": "0.0.1",
  "description": "Experimental tile based map editor",
  "main": "index.js",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "gjsify foreach build -v -t",
    "check": "gjsify foreach check -v -t",
    "check:barrels-clean": "gjsify foreach check:barrels -v -t",
    "check:specs": "node scripts/check-spec-registration.mjs",
    "check:assets": "node scripts/check-declared-assets.mjs",
    "check:phantom-deps": "node scripts/check-phantom-deps.mjs",
    "check:layer-visibility": "node scripts/check-layer-visibility.mjs",
    "check:mode-routes": "node scripts/check-mode-routes.mjs",
    "check:blp-actions": "node scripts/check-blp-actions.mjs",
    "check:signals": "node scripts/check-unemitted-signals.mjs",
    "check:orphan-components": "node scripts/check-orphan-components.mjs",
    "test": "gjsify foreach test -v -p --include @pixelrpg/engine --include @pixelrpg/gjs --include @pixelrpg/maker-gjs --include @pixelrpg/signalling-server --include @pixelrpg/mcp-bridge",
    "start": "gjsify workspace @pixelrpg/maker-gjs start",
    "start:storybook": "gjsify workspace @pixelrpg/gjs storybook",
    "clear": "gjsify foreach clear -v -p",
    "format": "biome check --write packages apps scripts",
    "lint": "biome ci packages apps scripts",
    "check:format": "biome format packages apps scripts",
    "flatpak:init": "gjsify workspace @pixelrpg/maker-gjs flatpak:init",
    "flatpak:check": "gjsify workspace @pixelrpg/maker-gjs flatpak:check",
    "flatpak:build": "gjsify workspace @pixelrpg/maker-gjs flatpak:build"
  },
  "author": "Pascal Garber <pascal@artandcode.studio>",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*",
    "games/*"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "typescript": "^7.0.2"
  }
}
