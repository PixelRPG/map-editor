<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="org.pixelrpg.maker">
  <enum id="org.pixelrpg.maker.Theme">
    <value nick="default" value="0"/>
    <value nick="force-light" value="1"/>
    <value nick="force-dark" value="2"/>
  </enum>
  <schema id="org.pixelrpg.maker" path="/org/pixelrpg/maker/">
