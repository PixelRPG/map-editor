using Gtk 4.0;
using Adw 1;

template $CastView : Adw.Bin {
  // The GALLERY half of the Library's Characters chip: a filterable
  // character roster. The detail half is a `$PixelRpgCastDetailPane`
  // living in the Library host's one `Adw.NavigationSplitView`, joined
  // by `attachDetail()` — this widget only reports what the user picked
  // (`detail-requested` / `detail-title`).
  //
  // Characters is a friendly hero/NPC roster. Sprite sheets
  // (appearances) live under Graphics; the detail just picks an
  // appearance and deep-links there to manage the asset.
  Gtk.Box {
    orientation: vertical;
    spacing: 0;

    // Role filter — All / Heroes / NPCs.
    Gtk.Box filter_bar {
      orientation: horizontal;
      halign: start;
      spacing: 6;
      margin-top: 8;
      margin-bottom: 8;
      margin-start: 12;
      margin-end: 12;

      Gtk.ToggleButton filter_all {
        label: _("All");
        active: true;
        styles ["pill"]
      }

      Gtk.ToggleButton filter_heroes {
        label: _("Heroes");
        group: filter_all;
        styles ["pill"]
      }

      Gtk.ToggleButton filter_npcs {
        label: _("NPCs");
        group: filter_all;
        styles ["pill"]
      }
    }

    Gtk.ScrolledWindow {
      hscrollbar-policy: never;
      vexpand: true;
      min-content-width: 1;

      child: Gtk.Box {
        orientation: vertical;
        spacing: 12;
        margin-start: 12;
        margin-end: 12;
        margin-bottom: 12;

        Gtk.ListBox roster_list {
          selection-mode: single;
          styles ["boxed-list"]
        }

        // Empty-roster hint (shown by TS when no character matches).
        Adw.StatusPage roster_empty {
          icon-name: "system-users-symbolic";
          title: _("No characters");
          description: _("Add a hero or an NPC to get started.");
          vexpand: false;
        }
      };
    }
  }
}
