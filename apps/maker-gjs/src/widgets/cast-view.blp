using Gtk 4.0;
using Adw 1;

template $CastView : $PixelRpgLibraryPage {
  // The Characters page of the Library: an `Adw.NavigationSplitView`
  // master-detail — a filterable character LIST on the left (sidebar)
  // and a rich detail pane on the right (content). On narrow widths
  // the split collapses to a drill-down (tap a row → detail with a
  // back button). The Library host owns the header (the chips + the
  // "+" button); the detail keeps a header bar of its own only while
  // collapsed, for that back button.
  //
  // Characters is a friendly hero/NPC roster. Sprite sheets
  // (appearances) live under Graphics; the detail just picks an
  // appearance and deep-links there to manage the asset.
  Adw.NavigationSplitView cast_split {
      min-sidebar-width: 300;
      max-sidebar-width: 340;
      collapsed: bind template.inspector-collapsed;

      // ── Master: filterable character roster ───────────────────────
      sidebar: Adw.NavigationPage {
        tag: "roster";
        title: _("Characters");

        child: Gtk.Box {
            orientation: vertical;
            spacing: 0;

            // Role filter — All / Heroes / NPCs.
            Gtk.Box filter_bar {
              orientation: horizontal;
              halign: start;
              spacing: 6;
              margin-top: 8;
              margin-bottom: 8;
              margin-start: 12;
              margin-end: 12;

              Gtk.ToggleButton filter_all {
                label: _("All");
                active: true;
                styles ["pill"]
              }

              Gtk.ToggleButton filter_heroes {
                label: _("Heroes");
                group: filter_all;
                styles ["pill"]
              }

              Gtk.ToggleButton filter_npcs {
                label: _("NPCs");
                group: filter_all;
                styles ["pill"]
              }
            }

            Gtk.ScrolledWindow {
              hscrollbar-policy: never;
              vexpand: true;
              min-content-width: 1;

              child: Gtk.Box {
                orientation: vertical;
                spacing: 12;
                margin-start: 12;
                margin-end: 12;
                margin-bottom: 12;

                Gtk.ListBox roster_list {
                  selection-mode: single;
                  styles ["boxed-list"]
                }

                // Empty-roster hint (shown by TS when no character matches).
                Adw.StatusPage roster_empty {
                  icon-name: "people-symbolic";
                  title: _("No characters");
                  description: _("Add a hero or an NPC to get started.");
                  vexpand: false;
                }

                Gtk.Label {
                  label: _("Add from template");
                  halign: start;
                  margin-top: 6;
                  styles ["caption-heading", "dim-label"]
                }

                Gtk.FlowBox template_slots {
                  selection-mode: none;
                  min-children-per-line: 2;
                  max-children-per-line: 2;
                  column-spacing: 6;
                  row-spacing: 6;
                  homogeneous: true;
                }
              };
            }
        };
      };

      // ── Detail: rich character view ───────────────────────────────
      content: Adw.NavigationPage detail_page {
        tag: "detail";
        title: _("Character");

        child: Adw.ToolbarView {
          // Only the collapsed (phone) layout needs this bar: it carries
          // the drill-down's back button. On desktop the detail's own
          // title-1 heading is the title and the Library header above
          // holds the window controls.
          [top]
          Adw.HeaderBar {
            show-end-title-buttons: false;
            visible: bind template.inspector-collapsed;
          }

          content: Gtk.Stack detail_stack {
            Gtk.StackPage {
              name: "empty";
              child: Adw.StatusPage {
                icon-name: "people-symbolic";
                title: _("No character selected");
                description: _("Pick a character from the list to see its details.");
              };
            }

            Gtk.StackPage {
              name: "info";
              // Measures the DETAIL PANE, not the window — at desktop the
              // pane is only part of the split, so keying the reflow to
              // the window would keep the wide layout in a narrow pane.
              //
              // `hscrollbar-policy: never` below propagates the child's
              // minimum straight up to the window, so anything that cannot
              // shrink here clips the whole page rather than scrolling.
              child: Adw.BreakpointBin detail_breakpoint {
                width-request: 240;
                height-request: 240;

                Adw.Breakpoint {
                  condition ("max-width: 420sp")

                  setters {
                    detail_header.orientation: vertical;
                    detail_actions.orientation: vertical;
                    detail_actions.halign: fill;
                    preview.frame-size: 128;
                  }
                }

                child: Gtk.ScrolledWindow {
                  hexpand: true;
                  vexpand: true;
                  hscrollbar-policy: never;

                  child: Adw.Clamp {
                    maximum-size: 640;
                    tightening-threshold: 460;

                    child: Gtk.Box {
                      orientation: vertical;
                      spacing: 18;
                      margin-top: 24;
                      margin-bottom: 24;
                      margin-start: 24;
                      margin-end: 24;

                      // Header row: preview card + identity (name/subtitle).
                      // Stats + actions live in full-width rows below so the
                      // detail reflows cleanly on phone (no horizontal run-off).
                      //
                      // Side by side this row measured 357 px minimum (a
                      // 180 px preview + 24 px gap + a `title-1` name, which
                      // cannot wrap mid-word), so `detail_breakpoint` stacks
                      // it and shrinks the preview below 420 px.
                      Gtk.Box detail_header {
                        orientation: horizontal;
                        spacing: 24;

                        $PixelRpgCharacterPreview preview {
                          frame-size: 180;
                          valign: start;
                        }

                        Gtk.Box {
                          orientation: vertical;
                          spacing: 6;
                          hexpand: true;
                          valign: center;

                          Gtk.Box {
                            orientation: horizontal;
                            spacing: 10;

                            Gtk.Label detail_name {
                              halign: start;
                              xalign: 0;
                              wrap: true;
                              hexpand: true;
                              styles ["title-1"]
                            }

                            Gtk.Label detail_player_badge {
                              label: _("Player character");
                              valign: center;
                              visible: false;
                              styles ["caption-heading", "accent"]
                            }
                          }

                          Gtk.Label detail_subtitle {
                            halign: start;
                            xalign: 0;
                            wrap: true;
                            styles ["dim-label"]
                          }
                        }
                      }

                      // 2×2 read-only stat summary (full width).
                      Gtk.Grid stat_grid {
                        column-spacing: 10;
                        row-spacing: 10;
                        column-homogeneous: true;
                      }

                      // Two labelled pills side by side measured 352 px —
                      // they do not fit a 360 px window either, so the same
                      // breakpoint stacks them.
                      Gtk.Box detail_actions {
                        orientation: horizontal;
                        halign: start;
                        spacing: 10;

                        // A door into Graphics, which Simple view does not
                        // have: Full view only. In Simple view the picker
                        // above is how a character changes its look.
                        Gtk.Button edit_appearance_button {
                          label: _("Edit appearance");
                          visible: bind template.full-view;
                          styles ["suggested-action", "pill"]
                        }

                        Gtk.Button place_button {
                          label: _("Place on map");
                          styles ["pill"]
                        }
                      }

                      // Editable fields (name / appearance / player / speed).
                      $PixelRpgCastInspector inspector {}

                      // Animation authoring — the Action×Direction matrix
                      // (moved here from the Sheets view). Reads the
                      // character's sheet animations; a cell drives the
                      // preview, double-click edits its frames.
                      $PixelRpgActionDirectionMatrix matrix {
                        margin-top: 8;
                      }

                      // Progressive disclosure: raw "all components" editor.
                      Gtk.Box advanced_slot {
                        orientation: vertical;
                      }
                    };
                  };
                };
              };
            }
          };
        };
      };
  }
}
