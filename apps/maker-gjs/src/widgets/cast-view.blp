using Gtk 4.0;
using Adw 1;

template $CastView : $PixelRpgResponsiveEditorView {
  // Outer OverlaySplitView holds the ModeRail (left navigation). The
  // central content is an `Adw.NavigationSplitView` master-detail: a
  // filterable character LIST on the left (sidebar) and a rich detail
  // pane on the right (content). On narrow widths the split collapses
  // to a drill-down (tap a row → detail with a back button).
  //
  // Cast is a Characters-only lens — a friendly hero/NPC roster. Sprite
  // sheets (appearances) live in the Sheets view; the detail just picks
  // an appearance and deep-links into the Sheets editor to tweak it.
  Adw.OverlaySplitView outer_split {
    sidebar-position: start;
    min-sidebar-width: 220;
    max-sidebar-width: 260;
    sidebar-width-fraction: 0.7;
    pin-sidebar: true;
    collapsed: bind template.library-collapsed;
    show-sidebar: bind template.show-library bidirectional;

    sidebar: $PixelRpgModeRail mode_rail {
      project-name: _("New Project");
      project-tagline: _("Cast view");
    };

    content: Adw.NavigationSplitView cast_split {
      min-sidebar-width: 300;
      max-sidebar-width: 340;
      collapsed: bind template.inspector-collapsed;

      // ── Master: filterable character roster ───────────────────────
      sidebar: Adw.NavigationPage {
        tag: "roster";
        title: _("Cast");

        child: Adw.ToolbarView {
          [top]
          Adw.HeaderBar {
            show-end-title-buttons: false;

            [start]
            Gtk.ToggleButton library_toggle {
              icon-name: "sidebar-show-symbolic";
              tooltip-text: _("Toggle library");
              active: bind template.show-library bidirectional;
            }

            title-widget: Gtk.Label {
              label: _("Characters");
              styles ["heading"]
            };

            [end]
            Gtk.Button new_character_button {
              icon-name: "list-add-symbolic";
              action-name: "win.new-character";
              tooltip-text: _("Add a new character");
              styles ["flat"]
            }
          }

          content: Gtk.Box {
            orientation: vertical;
            spacing: 0;

            // Role filter — All / Heroes / NPCs.
            Gtk.Box filter_bar {
              orientation: horizontal;
              halign: start;
              spacing: 6;
              margin-top: 8;
              margin-bottom: 8;
              margin-start: 12;
              margin-end: 12;

              Gtk.ToggleButton filter_all {
                label: _("All");
                active: true;
                styles ["pill"]
              }

              Gtk.ToggleButton filter_heroes {
                label: _("Heroes");
                group: filter_all;
                styles ["pill"]
              }

              Gtk.ToggleButton filter_npcs {
                label: _("NPCs");
                group: filter_all;
                styles ["pill"]
              }
            }

            Gtk.ScrolledWindow {
              hscrollbar-policy: never;
              vexpand: true;

              child: Gtk.Box {
                orientation: vertical;
                spacing: 12;
                margin-start: 12;
                margin-end: 12;
                margin-bottom: 12;

                Gtk.ListBox roster_list {
                  selection-mode: single;
                  styles ["boxed-list"]
                }

                // Empty-roster hint (shown by TS when no character matches).
                Adw.StatusPage roster_empty {
                  icon-name: "people-symbolic";
                  title: _("No characters");
                  description: _("Add a hero or an NPC to get started.");
                  vexpand: false;
                }

                Gtk.Label {
                  label: _("Add from template");
                  halign: start;
                  margin-top: 6;
                  styles ["caption-heading", "dim-label"]
                }

                Gtk.FlowBox template_slots {
                  selection-mode: none;
                  min-children-per-line: 2;
                  max-children-per-line: 2;
                  column-spacing: 6;
                  row-spacing: 6;
                  homogeneous: true;
                }
              };
            }
          };
        };
      };

      // ── Detail: rich character view ───────────────────────────────
      content: Adw.NavigationPage detail_page {
        tag: "detail";
        title: _("Character");

        child: Adw.ToolbarView {
          [top]
          Adw.HeaderBar {
            show-end-title-buttons: false;
          }

          content: Gtk.Stack detail_stack {
            Gtk.StackPage {
              name: "empty";
              child: Adw.StatusPage {
                icon-name: "people-symbolic";
                title: _("No character selected");
                description: _("Pick a character from the list to see its details.");
              };
            }

            Gtk.StackPage {
              name: "info";
              child: Gtk.ScrolledWindow {
                hexpand: true;
                vexpand: true;
                hscrollbar-policy: never;

                child: Adw.Clamp {
                  maximum-size: 640;
                  tightening-threshold: 460;

                  child: Gtk.Box {
                    orientation: vertical;
                    spacing: 18;
                    margin-top: 24;
                    margin-bottom: 24;
                    margin-start: 24;
                    margin-end: 24;

                    // Header row: preview card + identity (name/subtitle).
                    // Stats + actions live in full-width rows below so the
                    // detail reflows cleanly on phone (no horizontal run-off).
                    Gtk.Box {
                      orientation: horizontal;
                      spacing: 24;

                      $PixelRpgCharacterPreview preview {
                        frame-size: 180;
                        valign: start;
                      }

                      Gtk.Box {
                        orientation: vertical;
                        spacing: 6;
                        hexpand: true;
                        valign: center;

                        Gtk.Box {
                          orientation: horizontal;
                          spacing: 10;

                          Gtk.Label detail_name {
                            halign: start;
                            xalign: 0;
                            wrap: true;
                            hexpand: true;
                            styles ["title-1"]
                          }

                          Gtk.Label detail_player_badge {
                            label: _("Player character");
                            valign: center;
                            visible: false;
                            styles ["caption-heading", "accent"]
                          }
                        }

                        Gtk.Label detail_subtitle {
                          halign: start;
                          xalign: 0;
                          wrap: true;
                          styles ["dim-label"]
                        }
                      }
                    }

                    // 2×2 read-only stat summary (full width).
                    Gtk.Grid stat_grid {
                      column-spacing: 10;
                      row-spacing: 10;
                      column-homogeneous: true;
                    }

                    Gtk.Box {
                      orientation: horizontal;
                      halign: start;
                      spacing: 10;

                      Gtk.Button edit_appearance_button {
                        label: _("Edit appearance");
                        styles ["suggested-action", "pill"]
                      }

                      Gtk.Button place_button {
                        label: _("Place on map");
                        styles ["pill"]
                      }
                    }

                    // Editable fields (name / appearance / player / speed).
                    $PixelRpgCastInspector inspector {}

                    // Animation authoring — the Action×Direction matrix
                    // (moved here from the Sheets view). Reads the
                    // character's sheet animations; a cell drives the
                    // preview, double-click edits its frames.
                    $PixelRpgActionDirectionMatrix matrix {
                      margin-top: 8;
                    }

                    // Progressive disclosure: raw "all components" editor.
                    Gtk.Box advanced_slot {
                      orientation: vertical;
                    }
                  };
                };
              };
            }
          };
        };
      };
    };
  }
}
