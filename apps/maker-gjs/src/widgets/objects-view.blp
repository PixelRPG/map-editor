using Gtk 4.0;
using Adw 1;

template $ObjectsView : Adw.Bin {
  // The GALLERY half of the Library's Things chip: every entity
  // definition the project holds, grouped by category. The detail half
  // is a `$PixelRpgObjectDetailPane` living in the Library host's one
  // `Adw.NavigationSplitView`, joined by `attachDetail()` — this widget
  // only reports what the user picked (`detail-requested` /
  // `detail-title`). The host's detail header carries the delete button.
  Gtk.ScrolledWindow {
    hscrollbar-policy: never;
    min-content-width: 1;

    child: Adw.Clamp {
      maximum-size: 640;
      margin-top: 18;
      margin-bottom: 18;
      margin-start: 12;
      margin-end: 12;

      child: Gtk.Stack list_stack {
        Gtk.StackPage {
          name: "empty";

          // A slim hint only. The rich onboarding (status page,
          // Graphics → Characters → Things diagram, template tiles)
          // lives in `$PixelRpgObjectDetailPane`'s "none" page: this
          // widget is the SIDEBAR of the Library's
          // `Adw.NavigationSplitView`, which honours a sidebar child's
          // minimum width over `max-sidebar-width` — a status page here
          // pushed the 300 px sidebar out to 472 px.
          // The button drills the collapsed split into that page, so
          // the tiles stay reachable on a phone where the gallery is
          // the only visible half.
          child: Gtk.Box {
            orientation: vertical;
            spacing: 12;
            valign: center;

            Gtk.Label {
              label: _("No things yet.");
              wrap: true;
              justify: center;
              styles ["dim-label"]
            }

            Gtk.Button {
              label: _("Start from a template");
              halign: center;
              clicked => $_onEmptyStartClicked();
              styles ["pill", "suggested-action"]
            }
          };
        }

        Gtk.StackPage {
          name: "list";

          // One Adw.PreferencesGroup per category, built in
          // objects-view.ts from `groupThingsByCategory`.
          child: Gtk.Box objects_groups {
            orientation: vertical;
            spacing: 18;
            valign: start;
          };
        }
      };
    };
  }
}
