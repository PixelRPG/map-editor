using Gtk 4.0;
using Adw 1;

template $AtlasView : $PixelRpgResponsiveEditorView {
  // The World view is a map sidebar beside the canvas (REDESIGN.md
  // § 4.2). The sidebar carries the shared `ShellSidebarHeader` at the
  // same fixed width as the Library's and the Game's, so the destination
  // switcher never moves; below it come the maps, a "New map" row and
  // the details of the selected one. It replaced the old floating
  // switcher pill: the pill covered the map, the sidebar does not.
  //
  // On phone the split collapses: the sidebar is an overlay that the
  // "Maps" button or an edge swipe opens and that closes again once a
  // map is picked.
  //
  // The headerbar uses `extend-content-to-top-edge: true` on the content
  // toolbar view so the canvas extends behind it; the bar carries a
  // custom `atlas-headerbar` class for a translucent background, so the
  // canvas still reads through but the buttons stay legible.
  Adw.OverlaySplitView split {
    // `pin-sidebar: true` disables libadwaita's auto-`show-sidebar :=
    // !collapsed` flip during breakpoint transitions, so a sidebar the
    // person closed stays closed when the window grows again.
    pin-sidebar: true;
    show-sidebar: true;
    collapsed: bind template.inspector-collapsed;

    sidebar: Adw.ToolbarView {
      top-bar-style: flat;

      [top]
      $PixelRpgShellSidebarHeader shell_header {
        title: _("World");
        compact: bind template.compact;
      }

      content: $PixelRpgMapSidebar map_sidebar {};
    };

    content: Adw.ToolbarView {
      extend-content-to-top-edge: true;
      top-bar-style: flat;

      [top]
      Adw.HeaderBar content_header {
        styles ["flat", "atlas-headerbar"]

        title-widget: Adw.WindowTitle {
          title: _("World");
          visible: bind template.compact;
        };

        // Wide: hides and shows the sidebar (F9). Phone: the way to the
        // maps, named, because an icon alone is easy to miss there.
        [start]
        Gtk.ToggleButton sidebar_toggle {
          visible: bind template.compact inverted;
          icon-name: "sidebar-show-symbolic";
          action-name: "win.toggle-map-sidebar";
          tooltip-text: _("Show or hide the maps");
        }

        [start]
        Gtk.Button maps_button {
          visible: bind template.compact;
          label: _("Maps");
          action-name: "win.toggle-map-sidebar";
          tooltip-text: _("Show the maps");
        }
      }

      // The bin measures the CANVAS, not the window — the window's own
      // breakpoints cannot see what the sidebar leaves the OSDs.
      //
      // At the 360 px the phone tier actually gets, the start-aligned
      // zoom pill (233 px) and the end-aligned "New map" FAB (103 px)
      // have to share the width, so the FAB drops to its icon when it
      // runs out.
      content: Adw.BreakpointBin {
        width-request: 360;
        height-request: 400;

        // Only ONE breakpoint applies (adw-breakpoint-bin.c iterates in
        // reverse and breaks on the first match). Below 400 px even the
        // two pills collide (12 + 233 + 8 + 103 + 12 = 368), so the FAB
        // drops to its icon.
        Adw.Breakpoint {
          condition ("max-width: 399sp")

          setters {
            new_map_fab.label: "";
          }
        }

        child: Gtk.Overlay {
          // Overview minimap — whole-world-at-a-glance, top-right OSD.
          [overlay]
          Adw.Bin overview_frame {
            halign: end;
            valign: start;
            margin-top: 56;
            margin-end: 12;
            width-request: 150;
            height-request: 100;
            styles ["osd", "atlas-overview-frame"]

            child: $PixelRpgAtlasOverview atlas_overview {};
          }

          [overlay]
          $PixelRpgFloatingFab new_map_fab {
            halign: end;
            valign: end;
            margin-end: 12;
            margin-bottom: 12;
            label: _("New map");
            icon-name: "list-add-symbolic";
            action-name: "win.new-map";
            tooltip-text: _("Create a new map");
          }

          // Same zoom pill as the scene editor (fires win.zoom-*); in
          // the atlas the window routes those actions to the world
          // camera instead of the engine camera.
          [overlay]
          $PixelRpgFloatingZoom preview_zoom {
            halign: start;
            valign: end;
            margin-start: 12;
            margin-bottom: 12;
            compact: bind template.compact;
          }

          // Phone only: the selected map's quick path to "Open". On wide
          // the sidebar's details group says the same and more.
          [overlay]
          $PixelRpgMapSelectionBar selection_bar {
            halign: center;
            valign: end;
            margin-bottom: 12;
            full-view: bind template.full-view;
          }

          child: $PixelRpgAtlasCanvas atlas {
            compact: bind template.compact;
          };
        };
      };
    };
  }
}
