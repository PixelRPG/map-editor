using Gtk 4.0;
using Adw 1;

template $ApplicationWindow : Adw.ApplicationWindow {
  name: "application-window";
  default-width: 1280;
  default-height: 800;
  width-request: 360;
  height-request: 480;

  // Phone (<768sp): the shell's three destinations move into the
  // bottom `Adw.ViewSwitcherBar`, the views drop their wide-screen
  // switcher and the inspectors collapse into overlay drawers. The
  // threshold is `max-width: 767sp` so it does not double-match the
  // tablet range at exactly 768sp (REDESIGN.md § 3.3).
  //
  // There is no tablet breakpoint any more: the left mode rail was
  // its only setter, and tablet now uses the template defaults — the
  // wide switcher plus persistent inspectors.
  Adw.Breakpoint {
    condition ("max-width: 767sp")

    setters {
      view_switcher_bar.reveal: true;
      atlas_view.compact: true;
      library_view.compact: true;
      library_view.inspector-collapsed: true;
      scene_editor_view.inspector-collapsed: true;
      game_view.compact: true;
    }
  }

  // Top OSD bar density (compact mode + progressive button
  // disclosure) lives in `scene-editor.blp`'s own `Adw.BreakpointBin`
  // — the canvas can shrink far below the window when both sidebars
  // are open, so the breakpoints HAVE to be scoped to the canvas
  // allocation, not the window width.

  content: Adw.ToastOverlay toast_overlay {
   child: Gtk.Overlay {
    // Connection chip (REDESIGN.md § 4.7). Bottom-centre, 80 px up: clear
    // of the phone's bottom bar, of the top OSD bars and of the history
    // pill at bottom-left.
    [overlay]
    Gtk.Box connection_chip {
      visible: false;
      halign: center;
      valign: end;
      margin-bottom: 80;
      margin-start: 12;
      margin-end: 12;
      spacing: 8;
      styles ["toolbar", "osd"]

      Adw.Spinner {}

      Gtk.Label connection_label {
        ellipsize: end;
      }
    }

    // Two levels, not one flat stack: the project shell owns the view
    // switcher, the map editor deliberately has no shell navigation
    // (REDESIGN.md § 3.2). `Gtk.Stack` rather than `Adw.ViewStack`
    // because these pages are not switcher destinations.
    child: Gtk.Stack root_stack {
      vexpand: true;
      hexpand: true;
      transition-type: crossfade;
      // Default is `true`, which measures every page and uses the
      // max as the stack's size. With the scene editor's WebGL
      // canvas reporting a large natural width (~1200 px), that
      // bubbled up as the application window's minimum even while
      // the atlas view was shown — blocking the mobile breakpoint
      // from firing at <768 sp. Setting both to false makes the
      // stack track only the visible page's measurement.
      hhomogeneous: false;
      vhomogeneous: false;

      Gtk.StackPage {
        name: "welcome";
        title: _("Welcome");
        child: $WelcomeView welcome_view {};
      }

      Gtk.StackPage {
        name: "shell";
        title: _("Project");

        child: Adw.ToolbarView shell {
          // The view switcher stays up on phone at all times: it is the
          // way out of World. The map selection bar floats over the
          // canvas above it instead of replacing it.
          [bottom]
          Adw.ViewSwitcherBar view_switcher_bar {
            stack: shell_stack;
          }

          content: Adw.ViewStack shell_stack {
            vexpand: true;
            hexpand: true;
            hhomogeneous: false;
            vhomogeneous: false;

            Adw.ViewStackPage {
              name: "world";
              title: _("World");
              icon-name: "map-symbolic";
              child: $AtlasView atlas_view {};
            }

            Adw.ViewStackPage {
              name: "library";
              title: _("Library");
              icon-name: "library-symbolic";
              child: $PixelRpgLibraryView library_view {};
            }

            Adw.ViewStackPage {
              name: "game";
              title: _("Game");
              icon-name: "applications-games-symbolic";
              child: $PixelRpgGameView game_view {};
            }
          };
        };
      }

      // A permanent child of `root_stack` for the app's lifetime —
      // never reparented. The engine tears its Excalibur instance
      // down in `vfunc_unroot`, and a stray unroot kills the loop for
      // good (REDESIGN.md § 10, risk 4).
      Gtk.StackPage {
        name: "map";
        title: _("Map editor");
        child: $SceneEditorView scene_editor_view {};
      }
    };
   };
  };
}
