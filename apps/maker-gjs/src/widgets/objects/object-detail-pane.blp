using Gtk 4.0;
using Adw 1;

// The Things detail — the body of the Library's content pane: the name,
// the "Character" promotion toggle and the generated all-components
// editor for one entity definition.
//
// A widget of its own rather than a subtree of `objects-view.blp`,
// because the Library's one `Adw.NavigationSplitView` unmaps the SIDEBAR
// while a collapsed split shows the content. A single `SignalScope`
// spanning both halves would therefore disconnect the detail's handlers
// whenever the phone drilled in. Two widgets, two `vfunc_map`s: the
// gallery wires the list, the pane wires the detail, and each is live
// exactly while it is on screen.
template $PixelRpgObjectDetailPane : Adw.Bin {
  child: Gtk.Stack detail_stack {
    // Not horizontally homogeneous: a homogeneous stack measures every page,
    // hidden ones too, so one wide page set the minimum of the whole pane
    // and clipped it past a phone's right edge.
    hhomogeneous: false;

    // The project holds no things at all. The rich "what is a thing"
    // onboarding lives HERE rather than in the gallery, because
    // `Adw.NavigationSplitView` honours a sidebar child's minimum width
    // over `max-sidebar-width`: a status page plus a template grid in
    // the 300 px sidebar blew it up to 472 px. The gallery keeps a slim
    // hint; the content pane has the room.
    Gtk.StackPage {
      name: "none";

      child: Gtk.ScrolledWindow {
        hscrollbar-policy: never;

        child: Gtk.Box {
          orientation: vertical;
          spacing: 24;
          valign: center;

          Adw.StatusPage {
            icon-name: "view-grid-symbolic";
            title: _("Things are what your hero finds");
            vexpand: false;
          }

          Gtk.Box none_diagram_slot {
            orientation: horizontal;
            halign: center;
          }

          Gtk.Box {
            orientation: vertical;
            spacing: 8;
            halign: center;

            Gtk.Label {
              label: _("Start from a template");
              halign: center;
              styles ["caption-heading", "dim-label"]
            }

            Gtk.FlowBox none_templates {
              selection-mode: none;
              halign: center;
              min-children-per-line: 2;
              max-children-per-line: 4;
              column-spacing: 8;
              row-spacing: 8;
              homogeneous: true;
            }
          }
        };
      };
    }

    Gtk.StackPage {
      name: "empty";

      child: Adw.StatusPage {
        icon-name: "view-grid-symbolic";
        title: _("No thing selected");
        description: _("Pick a thing from the list to edit it.");
      };
    }

    Gtk.StackPage {
      name: "info";

      child: Gtk.ScrolledWindow {
        hscrollbar-policy: never;

        child: Adw.Clamp {
          maximum-size: 640;
          margin-top: 18;
          margin-bottom: 18;
          margin-start: 12;
          margin-end: 12;

          child: Gtk.Box {
            orientation: vertical;
            spacing: 18;

            // § 6.6 lands a freshly created thing here with "Place on
            // map" focused, so the Things detail gets the same single
            // primary action the character detail has (§ 4.4) — a thing
            // that is in the library but on no map does nothing yet.
            Gtk.Box {
              orientation: horizontal;
              halign: start;
              spacing: 10;

              Gtk.Button place_button {
                label: _("Place on map");
                styles ["suggested-action", "pill"]
              }
            }

            Adw.PreferencesGroup {
              Adw.EntryRow name_row {
                title: _("Name");
              }

              // Promote/demote an actor-like entity into the friendly
              // Characters roster — only sensible for entities with a
              // `visual` component, so the gallery hides it otherwise.
              Adw.SwitchRow cast_row {
                title: _("Character");
                subtitle: _("Show under Characters — edit its look, speed and player flag there.");
              }
            }

            $PixelRpgEntityComponentsEditor editor {
              full-view: bind template.full-view;
            }
          };
        };
      };
    }
  };
}
