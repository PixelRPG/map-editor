using Gtk 4.0;
using Adw 1;

template $TilesView : Adw.Bin {
  // The GALLERY half of the Library's Graphics chip: every picture sheet
  // the project holds, in two sections — tilesets paint maps,
  // appearances dress characters. The detail half is a
  // `$PixelRpgTilesDetailPane` living in the Library host's one
  // `Adw.NavigationSplitView`, joined by `attachDetail()`; this widget
  // only reports what the user picked (`detail-requested` /
  // `detail-title`).
  //
  // Each section keeps its own "+" rather than sharing the host's bottom
  // "New …" row: a new picture sheet is either a tileset or an
  // appearance, and the gallery is where that choice is visible.
  Gtk.ScrolledWindow {
    hexpand: true;
    vexpand: true;
    hscrollbar-policy: never;
    min-content-width: 1;

    child: Adw.Clamp {
      maximum-size: 480;

      child: Gtk.Box {
        orientation: vertical;
        spacing: 12;
        margin-top: 12;
        margin-bottom: 12;
        margin-start: 12;
        margin-end: 12;

        // Search + sort over the sheet cards.
        Gtk.Box {
          orientation: horizontal;
          spacing: 8;

          Gtk.SearchEntry search_entry {
            placeholder-text: _("Search graphics…");
            hexpand: true;
          }

          Gtk.DropDown sort_dropdown {
            valign: center;
            tooltip-text: _("Sort tilesets");

            model: Gtk.StringList {
              strings [
                _("Default order"),
                _("Name"),
                _("Tile size"),
                _("Usage"),
              ]
            };
          }
        }

        Gtk.Box {
          orientation: horizontal;
          spacing: 8;

          Gtk.Label {
            label: _("Tilesets");
            halign: start;
            hexpand: true;
            styles ["heading"]
          }

          Gtk.Button {
            icon-name: "list-add-symbolic";
            action-name: "win.new-tileset";
            tooltip-text: _("Import a new tileset");
            valign: center;
            styles ["flat", "circular"]
          }
        }

        $PixelRpgCardGallery tilesets_gallery {
          empty-title: _("No tilesets yet. Import one to start painting maps.");
          empty-icon: "view-grid-symbolic";
          delete-tooltip: _("Delete tileset");
        }

        // ── Appearances (character sprite sheets) ──────────────────
        // The other kind of picture sheet: a character's look + its
        // animations. Managed here as raw assets (import / delete /
        // glance); the detail's "Edit animations" jumps to the
        // Characters matrix to author them (`win.edit-appearance`).
        Gtk.Box {
          orientation: horizontal;
          spacing: 8;
          margin-top: 8;

          Gtk.Label {
            label: _("Appearances");
            halign: start;
            hexpand: true;
            styles ["heading"]
          }

          Gtk.Button {
            icon-name: "list-add-symbolic";
            action-name: "win.new-spriteset";
            tooltip-text: _("Import an appearance");
            valign: center;
            styles ["flat", "circular"]
          }
        }

        $PixelRpgCardGallery appearances_gallery {
          empty-title: _("No appearances yet. Import one to animate your characters.");
          empty-icon: "image-x-generic-symbolic";
          delete-tooltip: _("Delete appearance");
        }
      };
    };
  }
}
