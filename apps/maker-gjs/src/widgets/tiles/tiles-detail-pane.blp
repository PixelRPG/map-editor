using Gtk 4.0;
using Adw 1;

// The Graphics detail — the body of the Library's content pane for
// whatever the Graphics gallery has selected. Three pages, because the
// gallery holds two KINDS of sprite sheet:
//
//   "empty"       nothing selected yet (first paint, or an empty project)
//   "tileset"     the full tile palette plus the RESPONSIVE tile inspector
//   "appearance"  a read-only glance at a character sheet, with a jump to
//                 the animation matrix under Characters (its authoring home)
//
// On the tileset page the inspector is a pinned right sidebar
// (`side_slot`) on desktop; on phone it slides up in a bottom sheet
// (`tile_sheet`, a `Gtk.Revealer` — the libadwaita baseline predates
// `Adw.BottomSheet`). The single `inspector` widget is reparented between
// the two slots by tiles-detail-pane.ts, keyed on `inspector-collapsed`.
//
// A widget of its own rather than a subtree of `tiles-view.blp`, because
// the Library's one `Adw.NavigationSplitView` unmaps the SIDEBAR while a
// collapsed split shows the content. A single `SignalScope` spanning
// both halves would therefore disconnect the detail's handlers whenever
// the phone drilled in. Two widgets, two `vfunc_map`s: the gallery wires
// search, sort and the cards, the pane wires palette and inspector.
template $PixelRpgTilesDetailPane : Adw.Bin {
  child: Gtk.Stack detail_stack {
    Gtk.StackPage {
      name: "empty";

      // Ready-made packs sit under the import hint: a child with no
      // picture of their own taps one and has graphics.
      child: Gtk.ScrolledWindow {
        hscrollbar-policy: external;
        min-content-width: 1;

        child: Adw.Clamp {
          maximum-size: 480;

          child: Adw.StatusPage {
            icon-name: "view-grid-symbolic";
            title: _("No graphics yet");
            description: _("Add a ready-made pack, or import your own picture to paint maps or dress your characters.");

            child: Gtk.Box {
              orientation: vertical;
              spacing: 24;

              $PixelRpgStarterPackShelf empty_shelf {}

              Gtk.Button {
                label: _("Import a picture…");
                action-name: "win.new-tileset";
                halign: center;
                styles ["pill"]
              }
            };
          };
        };
      };
    }

    Gtk.StackPage {
      name: "tileset";

      // An `Adw.OverlaySplitView` because its `min/max-sidebar-width`
      // reliably caps the panel to a phone-ish width (a plain Box +
      // width-request either collapses or stretches next to the hexpanding
      // palette). Phone: the split is collapsed + the sidebar hidden, and
      // the inspector is reparented into the bottom-sheet revealer.
      child: Adw.OverlaySplitView tile_split {
        sidebar-position: end;
        min-sidebar-width: 260;
        max-sidebar-width: 360;
        pin-sidebar: true;
        collapsed: bind template.inspector-collapsed;

        sidebar: Gtk.ScrolledWindow {
          hscrollbar-policy: never;
          vscrollbar-policy: automatic;

          child: Gtk.Box side_slot {
            margin-top: 16;
            margin-bottom: 16;
            margin-start: 16;
            margin-end: 16;

            // Initial parent (desktop is the default layout).
            $PixelRpgTileInspector inspector {
              hexpand: true;
            }
          };
        };

        content: Gtk.Overlay {
          child: Gtk.Box {
            orientation: vertical;

            // Collision is AUTHORED here (REDESIGN.md § 6.4), so the
            // "Show walls" hatch gets its own switch above the grid
            // rather than only the editor's View menu. Same stateful
            // `win.toggle-walls` action, so sheet, palette and map
            // always agree; the palette learns the flag by binding to
            // the button rather than reaching for an action group.
            // A wrapping row: side by side the two need ~290 px, which
            // plus the 300 px inspector and the Library's 300 px gallery
            // overflowed a 768 px window.
            Adw.WrapBox {
              child-spacing: 12;
              line-spacing: 6;
              margin-top: 12;
              margin-start: 16;
              margin-end: 16;

              Gtk.ToggleButton walls_toggle {
                action-name: "win.toggle-walls";
                tooltip-text: _("Hatch every tile the hero cannot walk through");
                halign: start;

                child: Adw.ButtonContent {
                  icon-name: "collision-wall-symbolic";
                  label: _("Show walls");
                };
              }

              // The Wall brush. Picking `wall` or `free` turns the grid
              // below into a brush: one drag marks every tile it crosses,
              // which is the only workable way through a 1024-tile set
              // (the inspector edits one tile at a time).
              Adw.ToggleGroup brush_group {
                valign: center;

                Adw.Toggle {
                  name: "select";
                  icon-name: "edit-select-symbolic";
                  tooltip: _("Pick a tile to edit its properties");
                }

                Adw.Toggle {
                  name: "wall";
                  icon-name: "collision-wall-symbolic";
                  tooltip: _("Drag to mark tiles as walls");
                }

                Adw.Toggle {
                  name: "free";
                  icon-name: "collision-free-symbolic";
                  tooltip: _("Drag to mark tiles as walkable");
                }
              }
            }

            // The set's terrain brushes (TERRAIN.md § 5.1). One row,
            // here rather than in the tile inspector, because a brush
            // belongs to the SET and the inspector is the selected
            // TILE's pane — on a phone it is a bottom sheet that only
            // exists while a tile is picked. This column is the one
            // place both layouts render the same, so a single row
            // serves desktop and phone instead of two that drift.
            Gtk.ListBox {
              selection-mode: none;
              margin-top: 12;
              margin-start: 16;
              margin-end: 16;
              styles ["boxed-list"]

              Adw.ActionRow terrains_row {
                title: _("Ground brushes");
                // Replaced with the count as soon as a set is shown.
                subtitle: _("None yet");
                activatable: true;

                [suffix]
                Gtk.Image {
                  icon-name: "go-next-symbolic";
                  valign: center;
                  styles ["dim-label"]
                }
              }
            }

            // Dedicated ScrolledWindow around the palette so it scrolls
            // vertically once the grid has more rows than fit. `wrap` lets the
            // FlowBox flow against the available width.
            Gtk.ScrolledWindow palette_scroller {
              hexpand: true;
              vexpand: true;
              hscrollbar-policy: never;
              vscrollbar-policy: automatic;

              child: $PixelRpgTilePalette palette {
                wrap: true;
                halign: fill;
                valign: start;
                hexpand: true;
                vexpand: false;
                tile-size: 32;
                show-walls: bind walls_toggle.active;
                margin-top: 16;
                margin-bottom: 16;
                margin-start: 16;
                margin-end: 16;
              };
            }
          };

          // Phone bottom sheet. Non-modal — the palette above stays
          // clickable, so picking another tile just updates it.
          [overlay]
          Gtk.Revealer tile_sheet {
            valign: end;
            halign: fill;
            transition-type: slide_up;
            reveal-child: false;

            child: Gtk.Box {
              orientation: vertical;
              margin-top: 8;
              margin-bottom: 12;
              margin-start: 12;
              margin-end: 12;
              styles ["card", "tile-sheet"]

              Gtk.Box {
                orientation: horizontal;
                margin-top: 6;
                margin-start: 12;
                margin-end: 6;

                Gtk.Label {
                  label: _("Tile");
                  halign: start;
                  hexpand: true;
                  styles ["heading"]
                }

                Gtk.Button sheet_close {
                  icon-name: "window-close-symbolic";
                  tooltip-text: _("Close");
                  valign: center;
                  styles ["flat", "circular"]
                }
              }

              // Inspector parented here on phone.
              Gtk.ScrolledWindow {
                hscrollbar-policy: never;
                vscrollbar-policy: automatic;
                propagate-natural-height: true;
                max-content-height: 360;

                child: Gtk.Box sheet_slot {};
              }
            };
          }
        };
      };
    }

    Gtk.StackPage {
      name: "appearance";

      // A character sheet is managed as an ASSET here (import / delete /
      // glance); its animations are authored in the Characters matrix, so
      // this page glances and hands over. Both the kind line and the
      // button wording are literal: this page only ever shows an
      // appearance, and a name alone ("Scientist") reads as a character.
      child: Gtk.ScrolledWindow {
        hscrollbar-policy: never;
        vscrollbar-policy: automatic;

        child: Adw.Clamp {
          maximum-size: 480;

          child: Gtk.Box {
            orientation: vertical;
            spacing: 12;
            valign: center;
            margin-top: 18;
            margin-bottom: 18;
            margin-start: 18;
            margin-end: 18;

            $PixelRpgCharacterPreview preview {
              frame-size: 160;
              halign: center;
              show-controls: false;
              auto-cycle: true;
            }

            Gtk.Label {
              label: _("Appearance");
              halign: center;
              styles ["caption-heading", "dim-label"]
            }

            Gtk.Label name_label {
              halign: center;
              wrap: true;
              justify: center;
              styles ["title-2"]
            }

            Gtk.Label subtitle_label {
              halign: center;
              styles ["caption", "dim-label"]
            }

            Gtk.Button edit_button {
              label: _("Edit animations");
              halign: center;
              margin-top: 6;
              styles ["suggested-action", "pill"]
            }
          };
        };
      };
    }
  };
}
