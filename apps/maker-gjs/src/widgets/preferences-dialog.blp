using Gtk 4.0;
using Adw 1;

template $PreferencesDialog: Adw.PreferencesDialog {
  content-width: 480;
  title: _("Preferences");

  Adw.PreferencesPage {
    title: _("Preferences");
    icon-name: "preferences-system-symbolic";

    Adw.PreferencesGroup {
      title: _("View");

      Adw.ComboRow theme_row {
        title: _("Color Scheme");

        model: Gtk.StringList {
          strings [
            _("Auto"),
            _("Light"),
            _("Dark"),
          ]
        };

        notify::selected => $_onThemeSelected();
      }

      Adw.SwitchRow full_view_row {
        title: _("Full view");
        subtitle: _("Show every component, setting and template instead of just what a game is made of");
      }
    }

    Adw.PreferencesGroup {
      title: _("Editing");

      Adw.SwitchRow show_grid_row {
        title: _("Show grid by default");
        subtitle: _("What the tile grid is set to when you open a map");
      }
    }

    Adw.PreferencesGroup {
      title: _("Together");
      description: _("How you appear to the people you build a game with");

      Adw.EntryRow collab_name_row {
        title: _("Your name");
      }

      Adw.ActionRow collab_colour_row {
        title: _("Your colour");
        subtitle: _("Marks your cursor and your name for everyone else");
        activatable-widget: collab_colour_button;

        [suffix]
        Gtk.MenuButton collab_colour_button {
          valign: center;
          tooltip-text: _("Pick your colour");

          styles [
            "flat",
          ]
        }
      }

      Adw.SwitchRow collab_nearby_row {
        title: _("Visible to devices nearby");
        subtitle: _("Let people on the same network find your shared project without a code");
      }

      Adw.SwitchRow collab_assistant_row {
        title: _("AI collaborator");
        subtitle: _("Let the assistant build alongside you");
      }
    }
  }
}
