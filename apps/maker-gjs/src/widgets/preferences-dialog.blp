using Gtk 4.0;
using Adw 1;

template $PreferencesDialog: Adw.PreferencesDialog {
  content-width: 480;
  title: _("Preferences");

  Adw.PreferencesPage {
    title: _("Appearance");
    icon-name: "brush-monitor-symbolic";

    Adw.PreferencesGroup {
      title: _("Style");
      description: _("Follow the system style or force light or dark");

      Adw.ComboRow theme_row {
        title: _("Color Scheme");

        model: Gtk.StringList {
          strings [
            _("Auto"),
            _("Light"),
            _("Dark"),
          ]
        };

        notify::selected => $_onThemeSelected();
      }
    }
  }
}
