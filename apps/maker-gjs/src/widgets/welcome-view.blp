using Gtk 4.0;
using Adw 1;

// One scrolling column (REDESIGN § 4.1): no split view, no sidebar
// toggle. Recents used to live in a 380 px end sidebar that was
// REPARENTED inline on phone; the column reads the same at every width,
// so the reparenting — and the `inspector-collapsed` / `show-inspector`
// pair that drove it — is gone.
template $WelcomeView : Adw.Bin {
  Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      show-title: false;
      show-end-title-buttons: true;
      styles ["flat"]
    }

    content: Gtk.ScrolledWindow {
      hscrollbar-policy: never;
      vscrollbar-policy: automatic;
      propagate-natural-height: true;

      child: Adw.Clamp {
        maximum-size: 720;
        tightening-threshold: 500;
        hexpand: true;

        child: Gtk.Box {
          orientation: vertical;
          spacing: 0;
          margin-top: 24;
          margin-bottom: 36;
          margin-start: 24;
          margin-end: 24;

          $PixelRpgProjectHeroIcon {
            size: 80;
            halign: start;
          }

          Gtk.Label {
            label: _("PixelRPG Maker");
            halign: start;
            xalign: 0;
            // Wrap so the large title doesn't force a wide minimum window
            // width — a non-wrapping title-1's min width is the full text.
            wrap: true;
            wrap-mode: word_char;
            margin-top: 20;
            margin-bottom: 6;
            styles ["title-1"]
          }

          Gtk.Label {
            label: _("Draw maps, add heroes and doors, press Play.");
            halign: start;
            xalign: 0;
            wrap: true;
            wrap-mode: word_char;
            margin-bottom: 24;
            styles ["dim-label"]
          }

          // Continue: the project you were last in, as one large card
          // with its start map's preview. Built in `welcome-view.ts`
          // because it only exists when a recent project does, and it
          // is the first thing under the title so it sits in the phone's
          // thumb zone.
          Adw.Bin continue_slot {
            visible: false;
            margin-bottom: 28;
          }

          Gtk.Label {
            label: _("Start something new");
            halign: start;
            xalign: 0;
            margin-bottom: 10;
            styles ["caption-heading", "dim-label"]
          }

          // Two cards side by side from ~560 px, stacked below — the
          // WrapBox breaks on its children's natural width, which the
          // cards request (see TEMPLATE_CARD_WIDTH).
          Adw.WrapBox templates_wrap {
            child-spacing: 12;
            line-spacing: 12;
            justify: fill;
          }

          Gtk.Button open_button {
            label: _("Open a game from a file…");
            halign: start;
            margin-top: 12;
            styles ["flat"]
          }

          // Hidden until `setRecentProjects` finds something to show:
          // the Continue card above already covers the common case of
          // exactly one remembered project.
          Gtk.Box recents_section {
            orientation: vertical;
            spacing: 10;
            margin-top: 30;
            visible: false;

            Gtk.Label {
              label: _("Recent");
              halign: start;
              xalign: 0;
              styles ["caption-heading", "dim-label"]
            }

            Gtk.ListBox recents_list {
              selection-mode: none;
              styles ["boxed-list"]
            }
          }

          Gtk.Box {
            orientation: vertical;
            spacing: 10;
            margin-top: 30;

            Gtk.Label {
              label: _("Play together");
              halign: start;
              xalign: 0;
              styles ["caption-heading", "dim-label"]
            }

            // Rebuilt dynamically by `welcome-view.ts` from
            // SessionService's `service-discovered` / `service-gone`
            // events. No "No sessions found" row: an empty list is
            // hidden, because "nobody is hosting right now" is not news
            // a first-time user needs.
            Gtk.ListBox sessions_list {
              selection-mode: none;
              visible: false;
              styles ["boxed-list"]
            }

            // The cross-internet counterpart of the LAN list above: a
            // dialog rather than an inline entry, because a room code is
            // pasted once and the field is dead weight the rest of the
            // time.
            Gtk.ListBox {
              selection-mode: none;
              styles ["boxed-list"]

              Adw.ButtonRow join_row {
                title: _("Join with a code…");
                start-icon-name: "network-workgroup-symbolic";
              }
            }
          }
        };
      };
    };
  }
}
