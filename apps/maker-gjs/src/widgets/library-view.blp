using Gtk 4.0;
using Adw 1;

// Library — one shell destination for everything a project is made of.
// Three chips under the header switch between the Characters, Things
// and Graphics pages, which used to be three rail rows (Cast, Objects,
// Sheets) of the same master-detail shape over the same data. This
// host owns the one header; the chip pages carry none, and each page's
// DETAIL keeps its own header bar so the phone drill-down still has a
// back button.
template $PixelRpgLibraryView : $PixelRpgResponsiveEditorView {
  Adw.ToolbarView {
    top-bar-style: flat;

    [top]
    Adw.HeaderBar {
      show-start-title-buttons: false;

      // Wide screens put the shell's three destinations in the
      // header's title slot; on phone the window's
      // `Adw.ViewSwitcherBar` owns them at the bottom and the header
      // falls back to the page title (REDESIGN.md § 3.3). A Box with
      // two mutually-exclusive children rather than a Gtk.Stack: a
      // boolean cannot drive `visible-child-name` from Blueprint.
      //
      // `view_switcher.stack` is wired in code — `shell_stack` lives
      // in the window's template and a Blueprint `bind` cannot cross a
      // template boundary (`ResponsiveEditorView.attachShellSwitcher`).
      title-widget: Gtk.Box {
        halign: center;

        Adw.ViewSwitcher view_switcher {
          visible: bind template.compact inverted;
          policy: wide;
        }

        Adw.WindowTitle {
          title: _("Library");
          visible: bind template.compact;
        }
      };

      // Packed first, so it sits furthest from the centre: the primary
      // menu is the rightmost item before the window controls on every
      // shell view.
      [end]
      $PixelRpgProjectMenuButton project_menu {}

      // The per-chip primary action, swapped with the chip.
      [end]
      Gtk.Stack header_end {
        visible-child-name: bind pages.visible-child-name;
        hhomogeneous: false;

        Gtk.StackPage {
          name: "characters";

          child: Gtk.Button {
            icon-name: "list-add-symbolic";
            action-name: "win.new-character";
            tooltip-text: _("Add a character");
            styles ["flat"]
          };
        }

        Gtk.StackPage {
          name: "things";

          child: Gtk.Button new_thing_button {
            icon-name: "list-add-symbolic";
            tooltip-text: _("Add a thing");
            styles ["flat"]
          };
        }

        Gtk.StackPage {
          name: "graphics";

          child: Gtk.ToggleButton {
            icon-name: "sidebar-show-right-symbolic";
            tooltip-text: _("Toggle details");
            active: bind tiles_view.show-quickview bidirectional;
          };
        }
      }
    }

    content: Gtk.Box {
      orientation: vertical;

      // The honesty signal, once per project: revealed in Simple view
      // while the project holds content Simple view cannot show (a
      // script, custom data, a states[] overlay). A banner, not a
      // toast — toasts vanish, and this is the one message a child
      // must be able to reread. Derived from content, so it is absent
      // in the common case.
      Adw.Banner hidden_banner {
        title: _("This project uses scripts or other settings that Simple view hides");
        button-label: _("Full view");
        revealed: false;
        button-clicked => $_onBannerClicked();
      }

      // The chip filter, under the header at every width: on wide the
      // header's title slot is taken by the shell switcher, and the
      // chips belong to the content they filter either way
      // (REDESIGN.md § 3.3). `Adw.InlineViewSwitcher` drives `pages`
      // directly, which is what makes Graphics' Full-view-only rule a
      // page-visibility flip instead of the old add/remove-the-toggle
      // dance (`Adw.Toggle` has no `visible`).
      Adw.Clamp {
        maximum-size: 480;
        margin-top: 6;
        margin-bottom: 6;
        margin-start: 12;
        margin-end: 12;

        child: Adw.InlineViewSwitcher chips {
          stack: pages;
          display-mode: labels;
          homogeneous: true;
          can-shrink: true;
        };
      }

      // Non-homogeneous for the same reason as the window's root stack:
      // the stack must track only the visible page's measurement, or the
      // widest page's minimum keeps the phone breakpoint from firing.
      //
      // `visible-child-name` IS the view's `chip` property
      // (bidirectional), and the header's action stack follows it, so a
      // chip change from a click, a deep link or the `win.library-chip`
      // action takes the same one path.
      Adw.ViewStack pages {
        visible-child-name: bind template.chip bidirectional;
        hhomogeneous: false;
        vhomogeneous: false;
        vexpand: true;

        Adw.ViewStackPage {
          name: "characters";
          title: _("Characters");

          child: $CastView cast_view {
            inspector-collapsed: bind template.inspector-collapsed;
            full-view: bind template.full-view;
          };
        }

        Adw.ViewStackPage {
          name: "things";
          title: _("Things");

          child: $ObjectsView objects_view {
            full-view: bind template.full-view;
          };
        }

        Adw.ViewStackPage graphics_page {
          name: "graphics";
          title: _("Graphics");

          child: $TilesView tiles_view {
            inspector-collapsed: bind template.inspector-collapsed;
          };
        }
      }
    };
  }
}
