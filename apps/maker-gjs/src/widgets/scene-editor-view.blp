using Gtk 4.0;
using Adw 1;

template $SceneEditorView : $PixelRpgResponsiveEditorView {
  // No shell navigation here at any width: the map editor is a level
  // inside World, not a destination beside it (REDESIGN.md § 3.1), so
  // the window hides the view switcher while this page is up and the
  // editor's own back affordance returns to the atlas.
  //
  // No central headerbar either — even an empty `Adw.HeaderBar` with
  // `extend-content-to-top-edge: true` is a click-eater above the
  // canvas: it sits in front of the SceneEditor's `Gtk.Overlay`
  // children and silently swallows pointer events for the top
  // ~46 px, which is exactly where the editing pill (top-left
  // OSD) lives now. Buttons inside the floating pill became
  // un-clickable.
  //
  // Drag-the-window is available from the right sidebar's own flat
  // headerbar (RightInspector) and the context pill's
  // `Gtk.WindowControls`, so dropping the central bar costs nothing
  // functionally — the canvas just takes over the whole content area.
  //
  // No window-close X anywhere on the editor surfaces — quitting
  // lives in the primary menu (`app.quit` + `<Primary>q`), which the
  // context pill carries.
  Adw.OverlaySplitView inner_split {
    sidebar-position: end;
    // The floor is 320, not 280, since the Layers page gained the row
    // menu: eye, glyph, tile count, lock and "⋯" are all natural-width,
    // so the layer name is whatever is left over — at 280 that was about
    // 30 px and every name read "De…". The tablet still clears the
    // canvas floor at this width (768 − 320 = 448 > 360).
    min-sidebar-width: 320;
    max-sidebar-width: 320;
    // `pin-sidebar: true` disables libadwaita's auto-`show-sidebar :=
    // !collapsed` flip during breakpoint transitions (see
    // `adw-overlay-split-view.c:1457-1458`). Without this, resizing
    // from a mobile/tablet width up to desktop would force the sidebar
    // open even when the user had it closed.
    pin-sidebar: true;
    collapsed: bind template.inspector-collapsed;
    show-sidebar: bind template.show-inspector bidirectional;

    content: $PixelRpgSceneEditor editor {};

    sidebar: $PixelRpgRightInspector inspector {
      collapsed: bind template.inspector-collapsed;
    };
  }
}
