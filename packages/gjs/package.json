{
  "name": "@pixelrpg/gjs",
  "version": "0.0.1",
  "description": "GJS (GTK/Adwaita) widgets, previews, and Gio file helpers for the PixelRPG map editor",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "build:barrels": "gjsify barrels src/widgets/common src/widgets/editor src/widgets/sprite --exclude '\\.test\\.' --exclude '\\.spec\\.' --exclude '\\.test-data\\.' --exclude '\\.d\\.blp\\.ts$'",
    "check:barrels": "gjsify barrels --check src/widgets/common src/widgets/editor src/widgets/sprite --exclude '\\.test\\.' --exclude '\\.spec\\.' --exclude '\\.test-data\\.' --exclude '\\.d\\.blp\\.ts$'",
    "build": "gjsify run build:barrels",
    "check": "gjsify run build:barrels && tsc && node scripts/check-widget-invariants.mjs",
    "test": "gjsify test && gjsify run test:display",
    "test:display": "gjsify test --runtime gjs --entry src/test.display.mts --outdir dist/display",
    "storybook": "gjsify storybook"
  },
  "gjsify": {
    "storybook": {
      "applicationId": "org.pixelrpg.storybook",
      "title": "PixelRPG Storybook",
      "globals": "auto,dom"
    }
  },
  "exports": {
    "./index.css": "./src/index.css",
    "./map-summary": "./src/widgets/editor/map-summary.model.ts",
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@gjsify/canvas2d": "0.64.57",
    "@gjsify/dom-elements": "0.64.57",
    "@gjsify/event-bridge": "0.64.57",
    "@gjsify/storybook": "0.64.57",
    "@gjsify/webgl": "0.64.57",
    "@pixelrpg/engine": "workspace:*",
    "excalibur": "^1.0.1"
  },
  "devDependencies": {
    "@girs/adw-1": "^5.4.0",
    "@girs/gdk-4.0": "^5.4.0",
    "@girs/gdkpixbuf-2.0": "^5.4.0",
    "@girs/gio-2.0": "^5.4.0",
    "@girs/gjs": "^5.4.0",
    "@girs/glib-2.0": "^5.4.0",
    "@girs/gobject-2.0": "^5.4.0",
    "@girs/graphene-1.0": "^5.4.0",
    "@girs/gsk-4.0": "^5.4.0",
    "@girs/gtk-4.0": "^5.4.0",
    "@girs/gtksource-5": "^5.4.0",
    "@girs/pango-1.0": "^5.4.0",
    "@gjsify/cli": "0.64.57",
    "@gjsify/unit": "0.64.57",
    "typescript": "^7.0.2"
  }
}
