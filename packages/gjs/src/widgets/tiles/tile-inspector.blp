using Gtk 4.0;
using Adw 1;

// Header-less inspector — embedded directly into the Tiles detail page's
// content flow (NOT an overlay sidebar). The detail page owns navigation
// via its single back button; this is just the selected-tile properties.
template $PixelRpgTileInspector : Adw.Bin {
  styles ["tile-inspector"]

  Gtk.Box {
    orientation: vertical;
    spacing: 12;

    Gtk.Frame preview_frame {
      halign: center;
      width-request: 96;
      height-request: 96;
      styles ["card"]

      child: Gtk.Picture preview {
        content-fit: fill;
        halign: center;
        valign: center;
        can-shrink: false;
        width-request: 80;
        height-request: 80;
        margin-top: 8;
        margin-bottom: 8;
        margin-start: 8;
        margin-end: 8;
      };
    }

    Gtk.Label title_label {
      label: _("No tile selected");
      halign: center;
      styles ["title-4"]
    }

    // Walls by picture, not by switch: the author picks the shape they
    // can see. The ten pictograms are the writable `CollisionPreset`s
    // and the toggle names ARE the preset values, so the widget never
    // keeps a second copy of the list — `tile-inspector.ts` asks each
    // group which names it owns.
    //
    // THREE groups, not one, because an `Adw.ToggleGroup` does not wrap:
    // all ten side by side measure 373 px and the phone floor leaves the
    // inspector 328 px (REDESIGN § 10 risk 7, measured by
    // `tile-inspector.probe.ts`). Split whole-tile / halves / corners,
    // the `Adw.WrapBox` lays them on one line when there is room and
    // breaks between groups when there is not. Exactly one toggle is lit
    // across all three — the widget clears the other two.
    Adw.PreferencesGroup collision_group {
      title: _("Can the hero walk here?");
      description: _("Every placement of this tile on every map inherits the answer.");

      Adw.WrapBox collision_wrap {
        child-spacing: 6;
        line-spacing: 6;
        justify: fill;

        Adw.ToggleGroup collision_whole {
          homogeneous: true;
          can-shrink: true;
          sensitive: false;

          Adw.Toggle {
            name: "free";
            icon-name: "collision-free-symbolic";
            tooltip: _("Free — the hero walks straight through");
          }

          Adw.Toggle {
            name: "wall";
            icon-name: "collision-wall-symbolic";
            tooltip: _("Wall — the whole tile blocks");
          }
        }

        Adw.ToggleGroup collision_halves {
          homogeneous: true;
          can-shrink: true;
          sensitive: false;

          Adw.Toggle {
            name: "half-top";
            icon-name: "collision-half-top-symbolic";
            tooltip: _("Top half blocks");
          }

          Adw.Toggle {
            name: "half-bottom";
            icon-name: "collision-half-bottom-symbolic";
            tooltip: _("Bottom half blocks");
          }

          Adw.Toggle {
            name: "half-left";
            icon-name: "collision-half-left-symbolic";
            tooltip: _("Left half blocks");
          }

          Adw.Toggle {
            name: "half-right";
            icon-name: "collision-half-right-symbolic";
            tooltip: _("Right half blocks");
          }
        }

        Adw.ToggleGroup collision_corners {
          homogeneous: true;
          can-shrink: true;
          sensitive: false;

          Adw.Toggle {
            name: "corner-top-left";
            icon-name: "collision-corner-top-left-symbolic";
            tooltip: _("Top-left corner blocks");
          }

          Adw.Toggle {
            name: "corner-top-right";
            icon-name: "collision-corner-top-right-symbolic";
            tooltip: _("Top-right corner blocks");
          }

          Adw.Toggle {
            name: "corner-bottom-left";
            icon-name: "collision-corner-bottom-left-symbolic";
            tooltip: _("Bottom-left corner blocks");
          }

          Adw.Toggle {
            name: "corner-bottom-right";
            icon-name: "collision-corner-bottom-right-symbolic";
            tooltip: _("Bottom-right corner blocks");
          }
        }
      }

      // Shown only when the tile's shapes are not one of the ten — a
      // hand-written or Tiled-imported shape must not be silently
      // reinterpreted as the nearest pictogram.
      Gtk.Label custom_hint {
        label: _("This tile has a custom shape.");
        xalign: 0;
        wrap: true;
        visible: false;
        margin-top: 6;

        styles [
          "caption",
          "dim-label",
        ]
      }

      // Full view only: the shape editor magnifies the tile and wants
      // the room the tablet and phone panes do not have. The pictograms
      // above stay the answer everywhere else — they cover every shape
      // that is pickable rather than drawn.
      Gtk.Button shape_button {
        label: _("Draw a shape…");
        sensitive: false;
        visible: false;
        halign: start;
        margin-top: 6;
        styles ["flat"]
      }
    }

    Adw.PreferencesGroup properties_group {
      title: _("Tile properties");
      description: _("Semantic metadata consumed by gameplay systems (audio, encounters, surface effects).");

      Adw.ComboRow surface_row {
        title: _("Surface");
        subtitle: _("Influences footstep sounds + encounter tables.");
        sensitive: false;
        model: Gtk.StringList {
          strings [_("None"), _("Grass"), _("Dirt"), _("Stone"), _("Wood"), _("Water"), _("Sand"), _("Snow")]
        };
      }
    }
  }
}
