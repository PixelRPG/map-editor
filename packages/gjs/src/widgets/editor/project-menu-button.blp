using Gtk 4.0;
using Adw 1;

template $PixelRpgProjectMenuButton : Adw.Bin {
  Gtk.Box {
    orientation: horizontal;
    spacing: 0;

    // Share-session action — opens the maker's Together dialog.
    // The window registers `win.share-session`; when it isn't
    // installed (e.g. embedded in Storybook) the button auto-
    // hides via action-state propagation.
    Gtk.Button share_button {
      icon-name: "system-users-symbolic";
      tooltip-text: _("Together — who is building this with you");
      action-name: "win.share-session";
      styles ["flat"]
    }

    Gtk.MenuButton menu_button {
      icon-name: "open-menu-symbolic";
      menu-model: primary_menu;
      tooltip-text: _("Main Menu");
      primary: true;
      styles ["flat"]
    }
  }
}

menu primary_menu {
  section {
    item {
      label: _("Open Recent");
      action: "win.open-recent-projects";
    }
    item {
      label: _("Close Project");
      action: "win.close-project";
    }
  }
  // The tier switch, one click from every view. It took the slot of a
  // Style submenu that duplicated Preferences › Color Scheme; `app.theme`
  // stays for drivers, Preferences keeps the row.
  section {
    item {
      label: _("Full view");
      action: "app.full-view";
    }
  }

  section {
    item {
      label: _("Preferences");
      action: "app.preferences";
    }
    item {
      label: _("About PixelRPG Maker");
      action: "app.about";
    }
  }
  section {
    item {
      label: _("Quit");
      action: "app.quit";
    }
  }
}
