using Gtk 4.0;
using Adw 1;

template $PixelRpgLayersPage : Adw.Bin {
  Gtk.Box {
    orientation: vertical;
    spacing: 18;
    margin-top: 12;
    margin-bottom: 12;
    margin-start: 12;
    margin-end: 12;

    // Three fixed sections, top to bottom as the world is: what draws
    // on top of the hero is at the top of the list. Every section keeps
    // its header when empty — the header is the explanation.
    $PixelRpgLayerSection section_overlay {
      plane: "overlay";
      title: _("Above the hero");
      subtitle: _("Roofs, treetops, bridges you walk under");
    }

    $PixelRpgLayerSection section_hero {
      plane: "hero";
      title: _("At hero height");
      subtitle: _("Rocks, signs, things you walk around");
    }

    $PixelRpgLayerSection section_ground {
      plane: "ground";
      title: _("Below the hero");
      subtitle: _("Floors, grass, water, paths");
    }

    // Simple view's ONE "Add a layer", in place of the three the
    // sections carry in Full view: it adds to the active layer's plane,
    // which the empty action target stands for. Set in TS, because
    // Blueprint has no template-bound `action-target`.
    Gtk.ListBox simple_add_list {
      selection-mode: none;
      visible: false;
      styles ["boxed-list"]

      Adw.ButtonRow simple_add_row {
        title: _("Add a layer");
        start-icon-name: "list-add-symbolic";
        action-name: "win.new-layer";
      }
    }
  }
}
