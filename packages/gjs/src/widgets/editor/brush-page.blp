using Gtk 4.0;
using Adw 1;

// One "what the next stroke lays" surface, in two homes: the wide
// inspector's Brush page and the phone sheet's Brush page. The same
// instance is hosted in whichever slot the current layout exposes
// (`EditorPages.host`), so there is exactly one implementation of
// "which plane, which layer, which tileset, which tile, which object".
template $PixelRpgBrushPage : Adw.Bin {
  Gtk.Box {
    orientation: vertical;
    spacing: 12;
    margin-top: 12;
    margin-bottom: 12;
    margin-start: 12;
    margin-end: 12;

    // The three planes as pictures, not a list: "below the hero", "at
    // hero height", "above the hero". Tapping one activates that
    // plane's last-used layer.
    Adw.ToggleGroup plane_chips {
      homogeneous: true;
      can-shrink: false;
      tooltip-text: _("Which plane the next stroke lands on");
    }

    Gtk.Box layer_row {
      orientation: horizontal;
      spacing: 6;

      Gtk.Label layer_label {
        label: bind template.layer-name;
        halign: start;
        hexpand: true;
        ellipsize: end;
        styles ["heading", "dim-label"]
      }

      Gtk.Button layers_button {
        label: _("Layers…");
        tooltip-text: _("All layers on this map");
        styles ["flat"]
      }
    }

    // Tiles ↔ Things as peers. They used to be one scroll: the Things
    // grid sat BELOW a palette tall enough to need its own scrollbar,
    // so on a phone sheet nobody ever reached it.
    Adw.ToggleGroup mode_toggle {
      homogeneous: true;
      active-name: "tiles";

      Adw.Toggle {
        name: "tiles";
        label: _("Tiles");
        tooltip: _("Paint the ground, walls and water");
      }

      Adw.Toggle {
        name: "things";
        label: _("Things");
        tooltip: _("Place a person, a chest, a door");
      }
    }

    // Not homogeneous vertically: a two-row Things grid must not reserve
    // the height of a 32-row tileset, which on a phone sheet would be
    // the whole page.
    Gtk.Stack mode_stack {
      visible-child-name: bind mode_toggle.active-name;
      vhomogeneous: false;
      transition-type: crossfade;
      transition-duration: 120;
      vexpand: true;

      Gtk.StackPage {
        name: "tiles";

        child: Gtk.Box tiles_pane {
          orientation: vertical;
          spacing: 12;

          Gtk.Box tileset_row {
            orientation: horizontal;
            spacing: 6;

            // One chip per tileset the map references — thumbnail plus
            // name, scrolling sideways. This is the ONLY way to change
            // the painting tileset; there is no second "Switch…" path to
            // keep in sync with it.
            Gtk.ScrolledWindow tileset_scroller {
              hscrollbar-policy: automatic;
              vscrollbar-policy: never;
              propagate-natural-height: true;
              hexpand: true;

              child: Adw.ToggleGroup tileset_chips {
                can-shrink: false;
                halign: start;
              };
            }

            // The sheet's own copy of the View-menu item, where the
            // tiles are: "which of these can I not walk on?" is asked
            // while picking a tile, not from a menu two taps away. The
            // action is stateful, so this button and the menu item are
            // one switch with two handles.
            Gtk.ToggleButton walls_toggle {
              action-name: "win.toggle-walls";
              icon-name: "collision-wall-symbolic";
              tooltip-text: _("Hatch the tiles the hero cannot walk on");
              valign: center;
              styles ["flat"]
            }
          }

          // Both axes: the sheet is drawn whole at an integer scale, so
          // a wide tileset is panned rather than squeezed. 16 px tiles
          // reach 48 px, which is what makes a tap on a phone land.
          Gtk.ScrolledWindow sheet_scroller {
            hscrollbar-policy: automatic;
            vscrollbar-policy: automatic;
            propagate-natural-height: true;
            max-content-height: 460;
            min-content-height: 200;
            vexpand: true;

            child: $PixelRpgTileSheet sheet {
              show-walls: bind walls_toggle.active;
            };
          }

          // A project with no tiles yet: say what to do instead of
          // showing an empty sheet under a nameless heading.
          Adw.StatusPage empty_state {
            visible: false;
            icon-name: "image-x-generic-symbolic";
            title: _("No tiles yet");
            description: _("Import a picture and cut it into tiles to paint with.");

            child: Gtk.Button {
              label: _("Import a picture…");
              action-name: "win.new-tileset";
              halign: center;
              styles ["suggested-action", "pill"]
            };
          }
        };
      }

      Gtk.StackPage {
        name: "things";

        child: Gtk.ScrolledWindow things_scroller {
          hscrollbar-policy: never;
          vscrollbar-policy: automatic;
          propagate-natural-height: true;
          max-content-height: 460;
          vexpand: true;

          child: Gtk.Box {
            orientation: vertical;
            spacing: 6;

            // Six columns as the natural width with ellipsizing
            // captions: `wrap` keeps the per-line minimum at one
            // swatch, so the page still fits a 360 px phone — and the
            // sheet's minimum is never private, because
            // `Adw.BottomSheet` keeps its page and its bottom bar in
            // one homogeneous `Gtk.Stack`.
            $PixelRpgTilePalette object_palette {
              tile-size: 48;
              wrap: true;
              wrap-cap: 6;
              aspect-mode: "contain";
              styles ["object-brush-palette"]
            }

            // Shown only when the project has no placeable objects at
            // all, so the Things page is never an empty box.
            Gtk.Label objects_empty {
              label: _("No objects in the library yet");
              visible: false;
              halign: start;
              styles ["dim-label"]
            }
          };
        };
      }
    }
  }
}
