using Gtk 4.0;
using Adw 1;

template $PixelRpgSceneCard : Gtk.Button {
  styles ["scene-card", "flat"]

  child: Gtk.Box root {
    orientation: vertical;
    spacing: 4;

    // Free-floating title ABOVE the map body and centred over it — no
    // header bar, no background. It is part of the card's allocation,
    // so the atlas camera measures it to place the body
    // (`SceneCard.bodyOffsetY`).
    Gtk.Box title_row {
      orientation: horizontal;
      spacing: 4;
      halign: center;
      styles ["scene-card-title"]

      Gtk.Image start_badge {
        icon-name: "media-playback-start-symbolic";
        pixel-size: 12;
        visible: bind template.start-map;
        tooltip-text: _("The game starts on this map");
        styles ["scene-card-start-badge"]
      }

      Gtk.Label name_label {
        label: bind template.scene-name;
        ellipsize: end;
        max-width-chars: 22;
        styles ["caption-heading"]
      }
    }

    // The whole map, scaled to the atlas zoom. The camera sizes this
    // slot; its child (a `MiniMap` or a host-provided `MapPreview`)
    // fills it.
    Adw.Bin preview_slot {
      halign: center;
      overflow: hidden;
      styles ["scene-card-frame"]

      child: $PixelRpgMiniMap map {};
    }
  };
}
