using Gtk 4.0;
using Adw 1;

template $PixelRpgRightInspector : Adw.Bin {
  styles ["right-inspector"]

  Adw.ToolbarView {
    top-bar-style: flat;

    // Thin flat header acts as a drag region for the window. The
    // window-close X is gone — quitting now lives in the primary
    // menu (`app.quit` + `<Primary>q`). Keeping the bar means
    // empty space above the inspector body still grabs window-drag
    // gestures.
    //
    // The `[start]` close button is only visible while the inspector
    // is in overlay-drawer mode (`collapsed: true`, driven by the
    // window breakpoint at ≤ 1024sp). On narrow widths the drawer
    // can be wider than the visible canvas slice, so the outside-
    // tap-to-dismiss target shrinks to zero — the inside affordance
    // is the only reliable way to close it. On desktop the panel is
    // pinned so the button would be redundant + visually noisy.
    [top]
    Adw.HeaderBar {
      show-title: false;
      show-start-title-buttons: false;
      show-end-title-buttons: true;
      styles ["flat"]

      [start]
      Gtk.Button {
        visible: bind template.collapsed;
        icon-name: "window-close-symbolic";
        action-name: "win.toggle-inspector";
        tooltip-text: _("Close inspector");
        styles ["flat", "circular"]
      }
    }

    // The page switcher sits on top, under the header — the same three-page
    // order the phone sheet will use, so the pages read as one set.
    [top]
    Adw.InlineViewSwitcher switcher {
      stack: stack;
      display-mode: labels;
      homogeneous: false;
      can-shrink: false;
      margin-start: 12;
      margin-end: 12;
      margin-bottom: 6;
    }

    // Whole inspector body acts as a drag region for the window —
    // empty space between rows / below the active tab's content
    // grabs the window-drag; interactive widgets (list rows, the
    // search entry, scrollbars) consume their clicks normally and
    // bypass the WindowHandle.
    content: Gtk.WindowHandle {
      child: Gtk.ScrolledWindow {
        hexpand: true;
        vexpand: true;
        hscrollbar-policy: never;

        // The pages themselves are NOT built here: one set of page
        // widgets lives in `EditorPages` and is hosted either in these
        // slots or in the phone sheet's, never both. See
        // `docs/concepts/responsive-chrome.md`.
        child: Adw.ViewStack stack {
        vexpand: true;

        Adw.ViewStackPage {
          name: "brush";
          title: _("Brush");
          icon-name: "view-grid-symbolic";

          child: Adw.Bin brush_slot {};
        }

        Adw.ViewStackPage {
          name: "layers";
          title: _("Layers");
          icon-name: "view-list-symbolic";

          child: Adw.Bin layers_slot {};
        }

        Adw.ViewStackPage {
          name: "selected";
          title: _("Selected");
          icon-name: "document-properties-symbolic";

          child: Adw.Bin selected_slot {};
        }

        // Only while a test run is on (`memoryMode`): then it is the one page.
        Adw.ViewStackPage {
          name: "memory";
          title: _("Game memory");
          icon-name: "preferences-other-symbolic";
          visible: false;

          child: Adw.Bin memory_slot {};
        }
        };
      };
    };

  }
}
