using Gtk 4.0;
using Adw 1;

template $PixelRpgSceneEditor : Adw.Bin {
  // Responsive density is handled by FloatingTopBar's own internal
  // `Adw.BreakpointBin` (split ≥880sp ↔ merged), which observes the
  // CANVAS width and tracks it correctly all the way down: at a 360 px
  // window the bar reaches its <460sp stage (undo, redo, back, grid and
  // dim all inside the "⋯" menu), which is only reachable if the bin
  // measured ~336 px. A widget-internal `Adw.BreakpointBin` here would
  // therefore work too — the engine canvas does NOT keep this overlay's
  // allocation wide, because `application-window.blp:62-70` sets the
  // ViewStack's `hhomogeneous`/`vhomogeneous` to false precisely so the
  // WebGL canvas's large natural width stops propagating upward.
  //
  // The tool rail's desktop-vs-phone reflow is nevertheless driven from
  // `SceneEditor.setCompact` (called by SceneEditorView on the
  // `inspector-collapsed` breakpoint, which fires only <768sp) because
  // it keys on the WINDOW form factor, not on the canvas width: with
  // both sidebars open on a small desktop the canvas is narrow while
  // the device is still a desktop.
  Gtk.Overlay overlay {
    [overlay]
    $PixelRpgFloatingTopBar top_bar {}

    // Labelled tool rail on the left edge, tucked just under the top
    // bar. Owns tool selection (the top bar no longer carries a tool
    // button) so every tool is discoverable at a glance. On phone
    // widths `SceneEditor.setCompact` reflows it into a bottom bar.
    [overlay]
    $PixelRpgFloatingToolRail tool_rail {
      halign: start;
      valign: start;
      margin-start: 12;
      margin-top: 64;
    }

    // Bottom-left OSD stack — collaborators pill above the zoom pill.
    // One Box instead of two absolutely-margined overlays, so the pills
    // can never collide regardless of their heights.
    [overlay]
    Gtk.Box bottom_left_osds {
      orientation: vertical;
      spacing: 8;
      halign: start;
      valign: end;
      margin-start: 12;
      margin-bottom: 12;

      $PixelRpgFloatingCollaborators floating_collaborators {}

      $PixelRpgFloatingZoom zoom_osd {}
    }

    [overlay]
    $PixelRpgFloatingPlay floating_play {}

    child: Adw.Bin backdrop {
      // Diagonal-stripe scratchpad — visible wherever the engine canvas
      // doesn't cover the area. The map fills as much as possible; the
      // stripes only show through transparent regions of the canvas
      // (outside map bounds) and beyond it.
      styles ["editor-backdrop"]
      hexpand: true;
      vexpand: true;

      child: Gtk.Box engine_holder {
        orientation: vertical;
        halign: fill;
        valign: fill;
        hexpand: true;
        vexpand: true;
      };
    };
  }
}
