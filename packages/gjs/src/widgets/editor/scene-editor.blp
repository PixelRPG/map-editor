using Gtk 4.0;
using Adw 1;

template $PixelRpgSceneEditor : Adw.Bin {
  // The scene editor's floating chrome.
  //
  // TWO RULES DECIDE THIS SHAPE, both read out of source rather than
  // assumed, and both rule out a single declarative layout switch:
  //
  // 1. THE CANVAS MUST NEVER BE REPARENTED. The engine tears down in
  //    `vfunc_unroot` (`widgets/engine/engine.ts`), so any re-slotting
  //    kills the Excalibur loop for good (PR #66,
  //    `docs/concepts/responsive-chrome.md`). An `Adw.MultiLayoutView`
  //    re-slots every `Adw.LayoutSlot` child on a layout change, so the
  //    canvas cannot live in a slot. It has ONE parent for the life of
  //    the view: `engine_holder` in `overlay` in `bottom_sheet.content`.
  //
  // 2. NO SINGLE CHROME LAYER CAN FLOAT OVER THE CANVAS.
  //    `gtk_widget_pick` returns before descending into the children of
  //    a `can-target: false` widget (`gtkwidget.c`), so a full-size
  //    chrome layer would either eat every stroke (`can-target: true`)
  //    or make its own buttons unclickable. Every floating piece is its
  //    own `Gtk.Overlay` child.
  //
  // The wide<->phone switch is therefore `SceneEditor.setLayout`, which
  // moves two small GL-free widgets between slots. The three inspector
  // pages are not among them: `EditorPages` keeps one set of page
  // widgets and the host re-parents them into whichever slot pair the
  // layout uses (`pageSlots` here and on `RightInspector`).
  Adw.BreakpointBin ladder {
    // The bin measures the CANVAS, which is what the pills have to fit
    // into — not the window, which is wider whenever a sidebar is open.
    //
    // `width-request` is the phone floor, and the bin ENFORCES nothing
    // below it: a breakpoint bin ignores its child's minimum, and a child
    // that asks for more is allocated past the window's edge from x=0
    // with one `Adwaita-WARNING` in the log. Everything under it — bar,
    // sheet page, canvas overlay — has to fit 360 px on its own, and the
    // sheet's minimum is the wider of its page and its bar even while
    // closed (a homogeneous `Gtk.Stack` inside `Adw.BottomSheet`).
    // `phone-chrome.probe.spec.ts` measures that with GTK.
    width-request: 360;
    height-request: 400;

    // The ladder sets ONE property — the stage name — and
    // `chrome-stages.ts` turns (stage, layout, playing) into every flag.
    //
    // `Adw.BreakpointBin` activates exactly ONE breakpoint at a time
    // (adw-breakpoint-bin.c: reverse iteration, break on first match),
    // so setters do NOT stack. Writing each stage's full visible set out
    // here is how the bar this replaces ended up with two complete
    // button hierarchies and an overflow menu rebuilt from button
    // visibility. One property is the whole contract instead, and the
    // rules are unit-tested rather than diffed by eye.
    //
    // The thresholds are the canvas widths at which both pills fit with
    // a roster in the context pill, MEASURED (`phone-chrome.probe.spec.ts`
    // asks GTK) rather than derived from per-button arithmetic — the
    // design's §2.4 numbers land low at every rung, and the first
    // measured set was 8 px low again. `STAGE_MIN_CANVAS_PX` carries the
    // same four numbers, `scripts/check-chrome-stages.mjs` fails if either
    // side drifts, and `effectiveStage` demotes further for a roster
    // wider than one avatar.
    Adw.Breakpoint {
      condition ("min-width: 672sp")

      setters {
        template.stage: "compact";
      }
    }

    Adw.Breakpoint {
      condition ("min-width: 768sp")

      setters {
        template.stage: "normal-1";
      }
    }

    Adw.Breakpoint {
      condition ("min-width: 880sp")

      setters {
        template.stage: "normal-2";
      }
    }

    Adw.Breakpoint {
      condition ("min-width: 1176sp")

      setters {
        template.stage: "roomy";
      }
    }

    // Present at every size, inert on wide: `reveal-bottom-bar: false`
    // drives `bottom-bar-height` to 0 through the progress lerp, the
    // sheet is translated off-screen, and `can-open: false` disables the
    // swipe tracker (adw-bottom-sheet.c). The wide layout pays nothing
    // for the wrapper, and the canvas never changes parent when the
    // phone layout turns it on.
    child: Adw.BottomSheet bottom_sheet {
      modal: false;
      full-width: true;
      // Off: `sheet_grabber` in the sheet box is the handle. Two handles
      // would stack, and libadwaita's own is unreachable from here.
      show-drag-handle: false;
      can-open: false;
      reveal-bottom-bar: false;

      // libadwaita allocates the sheet's content at FULL height and lays
      // the bar over it (adw-bottom-sheet.c), so the bar would cover the
      // bottom of the map. Binding the overlay's bottom margin to the
      // bar's height docks it instead: the canvas ends where the bar
      // starts, and the shell's bottom-edge gesture band lands on the
      // bar rather than on paintable tiles.
      content: Gtk.Overlay overlay {
        margin-bottom: bind bottom_sheet.bottom-bar-height;

        child: Adw.Bin backdrop {
          // Diagonal-stripe scratchpad — visible wherever the engine
          // canvas doesn't cover the area.
          styles ["editor-backdrop"]
          hexpand: true;
          vexpand: true;

          child: Gtk.Box engine_holder {
            orientation: vertical;
            halign: fill;
            valign: fill;
            hexpand: true;
            vexpand: true;
          };
        };

        // ============================================================
        // EDITING PILL - start-aligned, wide layouts only.
        //
        // `halign: start`, NOT `fill`. The bar it replaces was one
        // full-width `Gtk.WindowHandle` with a spacer between its two
        // pills, so 571 px of visible map at 1280x800 started a window
        // drag instead of a stroke. Each pill now wraps only itself, and
        // the gap between them is canvas again.
        // ============================================================
        [overlay]
        Gtk.WindowHandle editing_handle {
          halign: start;
          valign: start;
          margin-top: 12;
          margin-start: 12;

          child: Gtk.Box editing_pill {
            orientation: horizontal;
            spacing: 2;
            styles ["toolbar", "osd", "editing-pill"]

            Gtk.Button back_button {
              action-name: "win.back-to-atlas";
              tooltip-text: _("Back to World");
              styles ["flat"]

              child: Gtk.Box {
                spacing: 4;

                Gtk.Image {
                  icon-name: "go-previous-symbolic";
                }

                Gtk.Label back_label {
                  visible: false;
                  label: bind template.map-name;
                  ellipsize: end;
                  max-width-chars: 14;
                }
              };
            }

            Gtk.Separator {
              orientation: vertical;
            }

            Gtk.Button undo_button {
              icon-name: "edit-undo-symbolic";
              action-name: "win.undo";
              tooltip-text: _("Undo (Ctrl+Z)");
              styles ["flat"]
            }

            Gtk.Button redo_button {
              icon-name: "edit-redo-symbolic";
              action-name: "win.redo";
              tooltip-text: _("Redo (Ctrl+Shift+Z)");
              styles ["flat"]
            }

            Gtk.Separator {
              orientation: vertical;
            }

            // The tool group lives here on wide and in the phone bar's
            // first row on phone - the SAME instance, moved by
            // `setLayout`, so there is one armed-tool state.
            Adw.Bin tools_slot_top {}

            // Not a `Gtk.MenuButton` with its own popover copy of the
            // brush surface: it opens the ONE Brush page where the
            // current layout keeps it — the inspector here, the sheet on
            // phone. `action-target` is set in TS: Blueprint has no
            // syntax for a GVariant literal.
            Gtk.Button badge_button {
              action-name: "win.sheet-page";
              tooltip-text: _("Brush");
              styles ["flat", "badge-button"]

              child: Gtk.Box {
                spacing: 8;
                margin-start: 2;

                Adw.Bin badge_slot_top {}

                Gtk.Label badge_label {
                  visible: false;
                  label: bind template.brush-label;
                }
              };
            }
          };
        }

        // Phone's only exit (decision 20): a 44 px circular target at
        // the top-left corner. The system back gesture may also work,
        // but measurement showed the shell SHARES that gesture rather
        // than the app owning it, so it is a bonus, not a contract.
        [overlay]
        Gtk.Button back_circle {
          visible: false;
          halign: start;
          valign: start;
          margin-top: 12;
          margin-start: 12;
          action-name: "win.back-to-atlas";
          tooltip-text: _("Back to World");
          styles ["osd", "back-circle"]

          child: Gtk.Box {
            spacing: 6;

            Gtk.Image {
              icon-name: "go-previous-symbolic";
            }

            Gtk.Label back_circle_label {
              label: bind template.map-name;
              ellipsize: end;
              max-width-chars: 16;
            }
          };
        }

        // ============================================================
        // CONTEXT PILL - end-aligned, every layout.
        // ============================================================
        [overlay]
        Gtk.WindowHandle context_handle {
          halign: end;
          valign: start;
          margin-top: 12;
          margin-end: 12;

          child: Gtk.Box context_pill {
            orientation: horizontal;
            spacing: 2;
            styles ["toolbar", "osd", "context-pill"]

            Adw.Bin roster_slot {}

            // Playing, on phone: Stop and Restart take the pill.
            Gtk.Button stop_button {
              visible: false;
              icon-name: "media-playback-stop-symbolic";
              action-name: "win.play";
              tooltip-text: _("Stop");
              styles ["flat"]
            }

            Gtk.Button restart_button {
              visible: false;
              icon-name: "view-refresh-symbolic";
              action-name: "win.restart";
              tooltip-text: _("Restart from the beginning");
              styles ["flat"]
            }

            // The map editor shows no shell navigation, so this pill is
            // its only header end and "..." is the only door to the
            // app's primary menu (REDESIGN.md § 3.3). Those items are
            // sections of this menu rather than a second
            // $PixelRpgProjectMenuButton beside it: two adjacent menu
            // buttons, and a "Share..." in both of them.
            Gtk.MenuButton overflow_button {
              icon-name: "view-more-symbolic";
              tooltip-text: _("More actions");
              styles ["flat"]
            }

            Gtk.ToggleButton inspector_toggle {
              icon-name: "sidebar-show-right-symbolic";
              action-name: "win.toggle-inspector";
              tooltip-text: _("Toggle inspector");
              styles ["flat"]
            }

            // With the inspector shut the pill is the window's end edge, so
            // the close button lives here; with it open the inspector's own
            // header sits at the edge and carries them.
            Gtk.WindowControls window_controls {
              side: end;
              visible: bind inspector_toggle.active inverted;
            }
          };
        }

        // ============================================================
        // HISTORY PILL - phone only, bottom-left, floating 12 px above
        // the docked bar (the overlay's margin-bottom is bound to the
        // sheet's bottom-bar-height). Undo is a visible button at every
        // width and never inside "..." (decision 18 - it is the ONLY
        // undo on touch, so it may not be two taps away); here it is
        // also in thumb reach, which the top-right corner is not.
        // Redo joins it: with the pill in the corner a thumb owns, the
        // "..." item it used to be is strictly worse.
        // ============================================================
        [overlay]
        Gtk.Box history_pill {
          visible: false;
          halign: start;
          valign: end;
          margin-start: 12;
          margin-bottom: 12;
          spacing: 2;
          styles ["toolbar", "osd", "history-pill"]

          Gtk.Button phone_undo {
            icon-name: "edit-undo-symbolic";
            action-name: "win.undo";
            tooltip-text: _("Undo");
            styles ["flat"]
          }

          Gtk.Button phone_redo {
            icon-name: "edit-redo-symbolic";
            action-name: "win.redo";
            tooltip-text: _("Redo");
            styles ["flat"]
          }
        }

        // Zoom as feedback, not furniture: bottom-centre, shown for
        // 1.2 s after a change, then faded out. The pill it replaces
        // held 10 324 px2 of the bottom-left corner permanently.
        [overlay]
        $PixelRpgZoomOsd zoom_osd {
          margin-bottom: 12;
        }

        // Full view only: the tile under the pointer.
        [overlay]
        Gtk.Box cursor_caption {
          visible: false;
          halign: start;
          valign: end;
          margin-start: 12;
          margin-bottom: 12;
          styles ["toolbar", "osd", "cursor-caption"]

          Gtk.Inscription cursor_label {
            text: bind template.cursor-text;
            min-chars: 8;
            nat-chars: 8;
            xalign: 0.0;
            styles ["caption", "numeric"]
          }
        }

        [overlay]
        $PixelRpgFloatingPlay floating_play {}
      };

      // ============================================================
      // PHONE BAR - docked, full width, two 44 px rows (108 px with the
      // 6 px margins and gap). Everything in it fits 360 px: the four
      // tools and the badge in row A, and in row B as many WHOLE recent
      // tiles as the width allows beside the "⌃" - six at the floor.
      // ============================================================
      bottom-bar: Gtk.Box phone_bar {
        orientation: vertical;
        spacing: 6;
        margin-top: 6;
        margin-bottom: 6;
        margin-start: 12;
        margin-end: 12;
        styles ["phone-bar"]

        Gtk.Box bar_row_a {
          orientation: horizontal;
          spacing: 8;

          Adw.Bin tools_slot_bar {
            hexpand: true;
          }

          Adw.Bin badge_slot_bar {}
        }

        $PixelRpgRecentTiles recent_tiles {}
      };

      // The phone home of the editor pages — the SAME three widgets the
      // wide inspector hosts, moved here by `EditorPages.host`.
      //
      // A plain box, deliberately NOT an `Adw.ToolbarView`: that widget's
      // `[top]` slot sits inside a `GtkWindowHandle`, and the sheet's own
      // swipe tracker force-claims every drag that starts on a window
      // handle (`should_force_drag` in adw-swipe-tracker.c), so our
      // detent gesture would never see one.
      //
      // Its natural height IS the sheet's height: libadwaita measures
      // this child and allocates that (adw-bottom-sheet.c), and
      // `sheet-height` itself is read-only. `Gtk.ScrolledWindow` does not
      // propagate its child's natural height, so the box measures to
      // whatever `height-request` `SceneEditor._setSheetHeight` puts on
      // it — which is how the detents move at all.
      sheet: Gtk.Box sheet_view {
        orientation: vertical;

        // Our own drag handle. libadwaita's is an internal `AdwGizmo`
        // with `can-target: false`, parented outside this template, so
        // `show-drag-handle` is off and this strip carries the drag and
        // the tap instead.
        Gtk.Box sheet_grabber {
          styles ["sheet-grabber"]

          tooltip-text: _("Drag to resize, tap to cycle");

          Adw.Bin {
            styles ["sheet-grabber-pill"]

            hexpand: true;
            halign: center;
            valign: center;
          }
        }

        Adw.InlineViewSwitcher sheet_switcher {
          stack: sheet_stack;
          display-mode: labels;
          homogeneous: false;
          can-shrink: true;
          halign: center;
          margin-bottom: 6;
          margin-start: 12;
          margin-end: 12;
        }

        Gtk.ScrolledWindow sheet_scroller {
          hexpand: true;
          vexpand: true;
          hscrollbar-policy: never;

          child: Adw.ViewStack sheet_stack {
            vexpand: true;

            Adw.ViewStackPage {
              name: "brush";
              title: _("Brush");
              icon-name: "view-grid-symbolic";

              child: Adw.Bin brush_slot_sheet {};
            }

            Adw.ViewStackPage {
              name: "layers";
              title: _("Layers");
              icon-name: "view-list-symbolic";

              child: Adw.Bin layers_slot_sheet {};
            }

            Adw.ViewStackPage {
              name: "selected";
              title: _("Selected");
              icon-name: "document-properties-symbolic";

              child: Adw.Bin selected_slot_sheet {};
            }
          };
        }
      };
    };
  }
}
