using Gtk 4.0;
using Adw 1;

template $PixelRpgSceneInspector : Adw.Bin {
  styles ["scene-inspector"]
  // No hard width-request — the inner ScrolledWindow handles
  // overflow, and a hard floor here would block the window from
  // shrinking past it (~1085 px on test runs), preventing the
  // mobile breakpoint (768sp) from ever firing.

  Adw.ToolbarView {
    top-bar-style: flat;

    // Thin flat header — provides a window drag region at the
    // inspector's top. The window-close X is gone — quitting now
    // lives in the primary menu (`app.quit` +
    // `<Primary>q`). `[start]` close button only shows in overlay-
    // drawer mode (≤ 1024sp) — see `right-inspector.blp` for the
    // rationale.
    [top]
    Adw.HeaderBar {
      show-title: false;
      show-start-title-buttons: false;
      show-end-title-buttons: true;
      styles ["flat"]

      [start]
      Gtk.Button {
        visible: bind template.collapsed;
        icon-name: "window-close-symbolic";
        action-name: "win.toggle-inspector";
        tooltip-text: _("Close inspector");
        styles ["flat", "circular"]
      }
    }

    // Drag region — empty space inside the inspector body moves
    // the window. Interactive widgets (Open Scene pill, teleport
    // rows) intercept clicks normally.
    content: Gtk.WindowHandle {
      child: Gtk.ScrolledWindow {
        hscrollbar-policy: never;
        vscrollbar-policy: automatic;

        child: Gtk.Box body {
      orientation: vertical;
      spacing: 12;
      margin-top: 16;
      margin-bottom: 16;
      margin-start: 16;
      margin-end: 16;

      Gtk.Frame preview_frame {
        styles ["card"]
        halign: center;
        margin-bottom: 4;

        child: Adw.Bin preview_slot {
          halign: center;
          valign: center;
          margin-top: 12;
          margin-bottom: 12;
          margin-start: 12;
          margin-end: 12;
        };
      }

      Gtk.Label name_label {
        label: bind template.scene-name;
        halign: start;
        styles ["title-3"]
      }

      Gtk.Label subtitle_label {
        label: bind template.subtitle-text;
        halign: start;
        styles ["caption", "dim-label"]
      }

      Gtk.Grid stats_grid {
        column-homogeneous: true;
        column-spacing: 6;
        row-spacing: 6;
        margin-top: 6;
      }

      Adw.PreferencesGroup teleports_group {
        title: _("Teleports");
        visible: bind template.has-teleports;
      }

      // The map-level verbs of § 6.1. They live here, on rows bound to
      // `win.*` actions, rather than on the atlas card itself: the card
      // is a `Gtk.Button` whose drag gesture claims presses in the
      // CAPTURE phase, so a control inside it would either never see a
      // click or break dragging. Phase 5.4 moves them to the selection
      // bar that replaces this inspector.
      Adw.PreferencesGroup map_group {
        title: _("Map");

        Adw.ButtonRow {
          title: _("Rename…");
          start-icon-name: "document-edit-symbolic";
          action-name: "win.rename-map";
        }

        Adw.ButtonRow {
          title: _("Duplicate");
          start-icon-name: "edit-copy-symbolic";
          action-name: "win.duplicate-map";
        }

        Adw.ButtonRow {
          title: _("Start the game here");
          start-icon-name: "media-playback-start-symbolic";
          action-name: "win.start-map";
        }

        Adw.ButtonRow {
          title: _("Delete");
          start-icon-name: "user-trash-symbolic";
          action-name: "win.delete-map";
          styles ["destructive-action"]
        }
      }

      Gtk.Button open_button {
        label: _("Open map");
        action-name: "win.open-scene";
        halign: fill;
        styles ["suggested-action", "pill"]
        margin-top: 8;
      }

      Adw.StatusPage empty_state {
        visible: bind template.empty;
        icon-name: "view-paged-symbolic";
        title: _("No map selected");
        description: _("Pick a map from the world to inspect it.");
      }
      };
      };
    };
  }
}
