using Gtk 4.0;
using Adw 1;

template $PixelRpgLayerRow : Adw.Bin {
  styles ["layer-row"]

  Gtk.Box body {
    orientation: horizontal;
    // 6, not the usual 8: five gaps sit between six children here, and
    // the only child that can give the difference back is the name.
    spacing: 6;
    margin-top: 4;
    margin-bottom: 4;
    margin-start: 6;
    margin-end: 6;

    Gtk.ToggleButton visibility_button {
      icon-name: bind template.visibility-icon;
      tooltip-text: _("Toggle layer visibility");
      active: bind template.visible bidirectional;
      styles ["flat", "circular"]
      valign: center;
    }

    // Which plane the layer draws on, as the same picture the section
    // header shows — so a row read on its own still says where it is.
    $PixelRpgDepthGlyph glyph {
      size: 24;
      plane: bind template.plane;
      valign: center;
    }

    // Read or rename in the SAME slot: a label swapped for an entry in
    // place keeps the row's height and the toggles' positions, so
    // starting a rename never makes the list jump under the thumb.
    Gtk.Stack name_stack {
      hexpand: true;
      valign: center;

      Gtk.StackPage {
        name: "label";

        child: Gtk.Label name_label {
          label: bind template.layer-name;
          halign: start;
          hexpand: true;
          ellipsize: end;
        };
      }

      Gtk.StackPage {
        name: "entry";

        child: Gtk.Entry name_entry {
          hexpand: true;

          accessibility {
            label: _("Layer name");
          }
        };
      }
    }

    Gtk.Label count_label {
      label: bind template.tile-count-text;
      halign: end;
      valign: center;
      styles ["caption", "numeric", "dim-label"]
    }

    Gtk.ToggleButton lock_button {
      icon-name: bind template.lock-icon;
      tooltip-text: _("Lock layer");
      active: bind template.locked bidirectional;
      styles ["flat", "circular"]
      valign: center;
    }

    // The row's own commands. The model is set from TS because the
    // actions are per-row (a `layer` action group on this widget), so
    // there is no name a template could write down.
    Gtk.MenuButton menu_button {
      icon-name: "view-more-symbolic";
      tooltip-text: _("Layer options");
      visible: false;
      styles ["flat", "circular"]
      valign: center;
    }
  }
}
