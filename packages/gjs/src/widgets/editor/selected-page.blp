using Gtk 4.0;
using Adw 1;

template $PixelRpgSelectedPage : Adw.Bin {
  // Two states, never both: nothing is selected, or one placement is.
  // A stack rather than `visible` flags so the empty state can fill the
  // page (the sheet at Full is tall and an empty list reads as a bug).
  Gtk.Stack stack {
    Gtk.StackPage {
      name: "empty";

      child: Adw.StatusPage {
        icon-name: "edit-select-all-symbolic";
        title: _("Nothing selected");
        description: _("Tap a thing on the map to edit it here.");
      };
    }

    Gtk.StackPage {
      name: "placement";

      child: Gtk.Box {
        orientation: vertical;
        spacing: 12;
        margin-top: 12;
        margin-bottom: 12;
        margin-start: 12;
        margin-end: 12;

        // The header: who this is. The name is the one editable field
        // here and commits on apply (✓ / Enter) rather than per
        // keystroke — a character each would be one undo entry and one
        // collab op each.
        Adw.PreferencesGroup {
          Adw.EntryRow name_row {
            title: _("Name");
            show-apply-button: true;

            [prefix]
            Gtk.Image sprite_image {
              pixel-size: 32;
              valign: center;
            }
          }

          Adw.ActionRow kind_row {
            title: _("Kind");
          }

          // Deliberately kept though the design's header list omits it:
          // this is the only place the user sees WHICH LAYER the
          // placement sits on, and the layer decides whether an edit is
          // allowed at all (a locked layer refuses).
          Adw.ActionRow position_row {
            title: _("Position");
          }

          Adw.ActionRow library_row {
            title: _("Edit in Library");
            activatable: true;
            visible: false;

            [suffix]
            Gtk.Image {
              icon-name: "go-next-symbolic";
              styles ["dim-label"]
            }
          }
        }

        // The generated component groups for THIS placement's
        // overrides. Filled by the host with an `EntityComponentsEditor`
        // so this page stays free of the component registry.
        Adw.Bin components_slot {}

        Adw.PreferencesGroup {
          Adw.ButtonRow duplicate_row {
            title: _("Duplicate");
            start-icon-name: "edit-copy-symbolic";
          }

          Adw.ButtonRow delete_row {
            title: _("Delete");
            start-icon-name: "user-trash-symbolic";
            styles ["destructive-action"]
          }
        }
      };
    }
  }
}
